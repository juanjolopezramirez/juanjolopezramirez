---
import Rosa from './Rosa.astro';
import { SOCIAL } from '../data/social.js';
import { META } from '../i18n/utils.js';
import { VIDEOS } from '../data/videos.js';
import { ENTITY, nombreDe } from '../data/entities.js';
import BrandDot from './BrandDot.astro';
import Icon from './Icon.astro';
import Red from './Red.astro';
const { lang, t } = Astro.props;

/* Las casas que firman alguna pieza, y solo esas: la ficha de una casa que
   no ha hecho ningun video no pinta nada en esta hoja. */
const creditos = [...new Set(VIDEOS.map((v) => v.for).filter(Boolean))]
  .map((id) => ENTITY[id]).filter(Boolean);
---
<!-- Todas las plataformas, de un vistazo.

     Centrada en todos los anchos, como el aviso de «ya estas aqui»: es lo
     que se abre desde el «+» de la fila del hero, y lo que se abre desde un
     boton se pone delante. Doce redes en una rejilla que cuadra justa: tres
     columnas en el telefono (tres por cuatro) y cuatro desde 600px (cuatro
     por tres). El fondo es un degradado de los verdes de la casa que se
     mueve despacio; con menos movimiento pedido, se queda quieto. -->
<div class="social-panel" id="social-panel" hidden>
  <div class="social-panel__scrim" data-close-social></div>
  <div class="social-panel__sheet" role="dialog" aria-modal="true" aria-labelledby="social-panel-title">
    <button class="social-panel__close" type="button" data-close-social aria-label={t('a11y.closePanel')}>&times;</button>
    <h2 class="social-panel__title" id="social-panel-title">{t('social.title')}</h2>
    <ul class="social-panel__grid">
      {SOCIAL.map((s, i) => (
        <li class="social-panel__item" style={`--d:${i * 35}ms`} data-ancho={s.ancho ? true : undefined}>
          <Red s={s} t={t} />
          <span class="social-panel__name">{s.name}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<!-- Dos cuentas, una por idioma. Instagram y TikTok estan repetidos, y
     hasta ahora la ficha elegia por ti: llevaba a la de español, y la
     otra no existia para quien no se la supiera de memoria.

     Es la hoja de escribirme —mismo velo, mismo filo de Iris, mismo
     cierre— pero dentro van filas y no fichas: lo que separa una opcion
     de la otra es un idioma, y para eso la casa ya tiene su gramatica,
     la del selector de idioma: la bandera, el nombre del idioma en su
     propio idioma, y aqui debajo el arroba.

     Los dos grupos se escriben enteros y el guion ensena el que toca:
     son unas lineas de HTML de mas y a cambio los cuatro enlaces estan
     en el documento desde el primer momento. -->
<div class="account-panel" id="account-panel" hidden>
  <div class="account-panel__scrim" data-close-account></div>
  <div class="account-panel__sheet" role="dialog" aria-modal="true" aria-labelledby="account-panel-title">
    <button class="account-panel__close" type="button" data-close-account aria-label={t('a11y.closePanel')}>&times;</button>
    <h2 class="account-panel__title" id="account-panel-title"></h2>
    <p class="account-panel__lead">{t('account.lead')}</p>
    {SOCIAL.filter((s) => s.accounts).map((s) => (
      <ul class="account-panel__list" data-account-group={s.id} hidden>
        {s.accounts.map((a) => (
          <li>
            {/* Con destino es un enlace; sin el, un boton que lo explica.
                Un <a href> vacio se ve igual y no lleva a ningun sitio. */}
            {a.href ? (
              <a class={`account-opt net--${s.id}`} href={a.href} target="_blank" rel="noopener noreferrer">
                <img class="account-opt__flag" src={META[a.lang].flag} alt="" width="40" height="40" />
                <span class="account-opt__text">
                  <span class="account-opt__lang" lang={a.lang}>{META[a.lang].name}</span>
                  <span class="account-opt__handle">{a.handle}</span>
                </span>
              </a>
            ) : (
              <button class={`account-opt net--${s.id} is-soon`} type="button" data-soon="soon.account">
                <img class="account-opt__flag" src={META[a.lang].flag} alt="" width="40" height="40" />
                <span class="account-opt__text">
                  <span class="account-opt__lang" lang={a.lang}>{META[a.lang].name}</span>
                  <span class="account-opt__handle">{a.handle}</span>
                </span>
                <span class="account-opt__badge">{t('soon.badge')}</span>
              </button>
            )}
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<!-- Una palabra que no es nuestra: que significa y quien lo dice -->
<div class="term-panel" id="term-panel" hidden>
  <div class="term-panel__scrim" data-close-term></div>
  <article class="term-panel__sheet" role="dialog" aria-modal="true" aria-labelledby="term-panel-title">
    <button class="term-panel__close" type="button" data-close-term aria-label={t('a11y.termClose')}>&times;</button>
    <p class="term-panel__script" id="term-panel-script" lang="he" dir="rtl"></p>
    <h2 class="term-panel__title" id="term-panel-title"></h2>
    <p class="term-panel__meta" id="term-panel-meta"></p>

    <!-- La mayoria de las palabras se explican en un parrafo y ya. Timoteo
         no: lleva titulo propio, un segundo bloque y el acordeon de los
         tres pilares. Los tres huecos se quedan vacios y ocultos cuando la
         palabra no los trae. -->
    <h3 class="term-panel__deftitle" id="term-panel-deftitle" hidden></h3>
    <p class="term-panel__def" id="term-panel-def"></p>
    <div class="term-panel__sections" id="term-panel-sections" hidden></div>
    <div class="term-panel__pillars" id="term-panel-pillars" hidden></div>
    <footer class="term-panel__cite">
      <h3 class="term-panel__cite-label" id="term-panel-source-label">{t('term.source')}</h3>
      <p class="term-panel__source" id="term-panel-source"></p>
    </footer>
  </article>
</div>

<!-- EL LIBRO DE UNA PALABRA.

     Ahava, Rhema, Emet y Agape no caben en una ficha: traen tres lecturas
     y una cuarta mas honda. Asi que se abren como lo que son, un libro
     pequeño: tapa, indice, «Cómo se vive», «De dónde viene», «Lo que es»,
     PaRDeS con su PARE, fuentes y contratapa.

     Las paginas las escribe site.js con el texto de term-cards.js y
     term-book.js; aqui solo esta el armazon. En pantalla ancha se ve a
     doble pagina y se pasa como un libro de verdad; en movil, una pagina
     cada vez. Se pasa arrastrando la esquina, tocando el borde, con las
     flechas de abajo o con las del teclado. -->
<!-- El dialogo es TODO el panel y no solo el marco: la × queda fuera del marco
     y un lector de pantalla puede esconder lo que queda fuera de un modal. Y
     por ser el panel el modal, sheet() deja inerte el resto de la pagina
     mientras esta abierto (site.js). -->
<div class="book-panel" id="book-panel" role="dialog" aria-modal="true" aria-labelledby="book-title" hidden>
  <div class="book-panel__scrim" data-close-book></div>
  <button class="book-panel__close" type="button" data-close-book aria-label={t('a11y.termClose')}>&times;</button>
  <div class="book-panel__frame">
    <h2 class="sr-only" id="book-title"></h2>
    <div class="book" id="book">
      <div class="book__block" id="book-block"></div>
    </div>
    <!-- Si la palabra tiene su PDF (tools/books.py), el libro es este:
         las paginas del PDF, que se doblan desde la esquina como papel. -->
    <div class="flip" id="flip" hidden></div>
    <!-- LA CARGA. Un libro en PDF son diez imagenes y una libreria; si la
         conexion va lenta, antes se veia una caja vacia. Esto ocupa el
         lugar del libro mientras llega y dice que esta pasando: una rosa
         de los vientos (el loader de Uiverse, de Nawsome) dibujada a mano,
         en tiza sobre el pinar, con los trazos del resto del sitio: aros de
         una vuelta que se pasan del punto de partida, agujas contorneadas
         con rayado, y una marca por pagina que se enciende cuando esa
         pagina llega. Las marcas, los textos y los botones los pone site.js
         (styles/carga.css). Los ids de la mascara llevan prefijo: otros SVG
         de la pagina ya usan `grad`. -->
    <div class="carga" id="book-load" role="status" aria-atomic="false" aria-relevant="additions text" hidden>
      <Rosa prefijo="carga" idMarcas="book-load-ticks" />
      <h3 class="carga__titulo" id="book-load-title"></h3>
      <p class="carga__paso"><span id="book-load-step"></span> <span class="carga__cuenta" id="book-load-count" aria-hidden="true"></span></p>
      <p class="carga__vera" id="book-load-see"></p>
      <p class="carga__aviso" id="book-load-note" hidden></p>
      <div class="carga__acciones" id="book-load-actions" hidden>
        <button class="carga__btn carga__btn--si" type="button" data-book-now hidden>{t('book.load.now')}</button>
        <button class="carga__btn carga__btn--si" type="button" data-book-retry hidden>{t('book.load.retry')}</button>
        <button class="carga__btn" type="button" data-book-text hidden>{t('book.load.text')}</button>
      </div>
    </div>
    <nav class="book__nav">
      <!-- La lupa: la unica manera de agrandar el libro (el zoom del
           navegador esta apagado aqui dentro). Solo en los libros en PDF. -->
      <button class="book__arrow book__zoom" type="button" data-book-zoom aria-pressed="false" aria-label={t('a11y.bookZoom')} hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6" />
          <path d="M15 15l5 5" />
          <path d="M8 10.5h5" />
          <path class="book__zoom-plus" d="M10.5 8v5" />
        </svg>
      </button>
      <button class="book__arrow" type="button" data-book-prev aria-label={t('a11y.bookPrev')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <p class="book__folio" id="book-folio" aria-live="polite"></p>
      <button class="book__arrow" type="button" data-book-next aria-label={t('a11y.bookNext')}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
      <!-- El sonido de las hojas, como en un flipbook: se puede apagar y
           el navegador lo recuerda -->
      <button class="book__arrow book__sound" type="button" data-book-sound aria-pressed="true" aria-label={t('a11y.bookSound')}>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 9.5v5h3.5L12 18.5v-13L7.5 9.5z" />
          <path class="book__sound-on" d="M15.5 9a4.2 4.2 0 0 1 0 6M18 6.5a7.8 7.8 0 0 1 0 11" />
          <path class="book__sound-off" d="M16 9.5l5 5M21 9.5l-5 5" />
        </svg>
      </button>
    </nav>
  </div>
  <!-- El sello, para que el guion lo copie en «Lo que es» y en la contratapa -->
  <template id="book-mark"><Icon id="mark" /></template>
</div>

<!-- Las piezas: dos pasos en la misma hoja.

     Primero la galeria — las tres portadas enteras, de frente y sin nada
     encima, en fila en pantalla ancha y deslizables en movil. El boton de
     informacion va DEBAJO de cada portada, fuera de la imagen: encima
     desaparecia sobre una portada oscura como la de «Mi único», y taparle
     un trozo a cada una para que se viera era pagar el arreglo con lo que
     se queria enseñar.

     Despues la ficha de la pieza elegida. Es la misma hoja cambiando de
     cara, no una segunda encima: apilar dos ventanas para leer un parrafo
     obliga a cerrar dos veces. -->
<div class="video-panel" id="video-panel" hidden>
  <div class="video-panel__scrim" data-close-video></div>
  <div class="video-panel__sheet" role="dialog" aria-modal="true" aria-labelledby="video-panel-heading">
    <button class="video-panel__close" type="button" data-close-video
            aria-label={t('a11y.closePanel')}>&times;</button>

    <!-- Paso uno: las tres -->
    <div class="video-gallery" id="video-gallery">
      <h2 class="video-panel__heading" id="video-panel-heading">{t('videos.title')}</h2>
      <ul class="video-gallery__row" data-carril data-antes={t('carousel.prev')} data-despues={t('carousel.next')}>
        {VIDEOS.map((v) => (
          <li class="video-gallery__item">
            {/* De quien es la pieza, ENCIMA de la portada y no debajo: es el
                orden de un post —primero de quien, despues que— y es el que
                hace que el circulo se lea como una cara de perfil. */}
            {ENTITY[v.for] && (
              <p class="video-gallery__by">
                <BrandDot mark={ENTITY[v.for].mark} logo={ENTITY[v.for].avatar ?? ENTITY[v.for].src} w={ENTITY[v.for].avatarW} h={ENTITY[v.for].avatarH} />
                <span class="video-gallery__by-name">{nombreDe(ENTITY[v.for], lang)}</span>
              </p>
            )}

            {/* La portada ya no es una imagen quieta: es la puerta al video.
                Un clic y estas viendolo — la ficha de al lado esta para quien
                quiera saber antes de mirar, no en medio del camino. */}
            <a class="video-gallery__cover" href={v.href} target="_blank" rel="noopener noreferrer">
              <picture>
                <source srcset={v.webp} type="image/webp" />
                <img src={v.src} alt={v.title.es} width="700" height="1244" decoding="async" />
              </picture>
              <span class="sr-only">— {t('videos.watch')}</span>
            </a>

            <button class="video-gallery__info" type="button" data-video={v.id}>
              <Icon id="info" /><span>{t('videos.about')}</span>
            </button>
          </li>
        ))}
      </ul>
      <p class="video-panel__note">{t('videos.note')}</p>
    </div>

    <!-- Paso dos: una -->
    <article class="video-detail" id="video-detail" hidden>
      <button class="video-detail__back" type="button" data-video-back>
        <Icon id="arrow" /><span>{t('videos.back')}</span>
      </button>
      <picture class="video-detail__cover">
        <source id="video-detail-webp" type="image/webp" />
        <img id="video-detail-img" alt="" width="700" height="1244" decoding="async" />
      </picture>
      <h3 class="video-detail__title" id="video-detail-title"></h3>
      <p class="video-detail__orig" id="video-detail-orig" lang="es" hidden></p>
      <p class="video-detail__blurb" id="video-detail-blurb"></p>

      <!-- Para quien se hizo.

           Las marcas se escriben TODAS y el guion ensena la que toca, igual
           que las cuentas por idioma de aqui arriba: es la misma hoja para
           las tres piezas, y lo que dejo la anterior tiene que poder irse
           sin que haya que construir nada nuevo. Con una marca es una fila;
           con cinco son cinco, y ninguna cuesta una peticion de mas. -->
      <div class="made-for" id="video-detail-for" hidden>
        <h4 class="made-for__label">{t('videos.madeFor')}</h4>
        {creditos.map((e) => (
          <p class="made-for__who" data-brand={e.id} hidden>
            <BrandDot mark={e.mark} logo={e.avatar ?? e.src} w={e.avatarW} h={e.avatarH} />
            <span class="made-for__text">
              <b>{nombreDe(e, lang)}</b>
              <small>{e.role?.[lang] ?? e.role?.es}</small>
            </span>
          </p>
        ))}
      </div>

      <a class="video-detail__link" id="video-detail-link" target="_blank" rel="noopener noreferrer">
        <span>{t('videos.watch')}</span><Icon id="corner" />
      </a>
    </article>
  </div>
</div>

<!-- Ya estas aqui.

     Salta cuando alguien pulsa en el menu la seccion que ya esta viendo.
     Va centrado y con velo: hay que cerrarlo para seguir, que es justo lo
     que evita el segundo clic a ciegas. Cerrar con la equis, con el velo o
     con Escape — las tres, porque un aviso del que no se sale es peor que
     el despiste que viene a arreglar. -->
<div class="here-panel" id="here-panel" hidden>
  <div class="here-panel__scrim" data-close-here></div>
  <div class="here-panel__sheet" role="dialog" aria-modal="true"
       aria-labelledby="here-panel-title" aria-describedby="here-panel-body">
    <button class="here-panel__close" type="button" data-close-here
            aria-label={t('a11y.closePanel')}>&times;</button>
    <p class="here-panel__mark" aria-hidden="true"><Icon id="mark" /></p>
    <h2 class="here-panel__title" id="here-panel-title">{t('here.title')}</h2>
    <p class="here-panel__body" id="here-panel-body">{t('here.body')}</p>
    <button class="here-panel__ok" type="button" data-close-here>{t('here.ok')}</button>
  </div>
</div>

<!-- Lo que todavia no esta. Se anuncia y se va solo. -->
<div class="toast" id="toast" role="status" aria-live="polite" hidden>
  <p class="toast__text" id="toast-text"></p>
  <button class="toast__close" type="button" data-close-toast aria-label={t('a11y.dismiss')}>&times;</button>
</div>
