---
import { LIBROS, SECCIONES, TIPOS, PORTADAS, CARTELERA } from '../data/biblioteca.js';
import { TERMS } from '../i18n/terms.js';
import { GLOSS } from '../i18n/term-cards.js';
import { BOOKS } from '../data/books.js';
import { fichaLibro, indexar, rutaPortadaValida, contraste, BUSCAR_MAX } from '../scripts/biblioteca.js';
import Tapa from './Tapa.astro';
import Icon from './Icon.astro';
import fs from 'node:fs';
import path from 'node:path';
import '../styles/biblioteca.css';

/* DESTACADOS: la seccion tipo Netflix, bajo la biblioteca.

   Arriba, la CARTELERA: un libro grande (data/biblioteca.js → CARTELERA), con su
   portada de fondo y su portada de frente, que se mueven a distinta velocidad
   al hacer scroll. Debajo, una FILA por tema (como las de la biblioteca), con las
   portadas de frente sobre UNA repisa seguida que se desliza de lado, y al fondo
   una pared con su luz que se mueve mas despacio que los libros: ese es el
   parallax. Mas una fila «Pronto» con la portada de lo que aun se escribe.

   Cada tarjeta es UN enlace a la ancla del libro (#ahava) y abre el mismo lector
   que su lomo: site.js → initBiblioteca atiende todo `a[data-libro]` de la
   pagina, y el foco vuelve a la tarjeta (o al boton de la cartelera) al cerrar.

   LOS DATOS son los de siempre (LIBROS, SECCIONES) y la ficha de cada libro, la
   de fichaLibro() (scripts/biblioteca.js): la misma que usan la estanteria y las
   portadas. No se inventa nada: la fila «Pronto» sale de las portadas SUELTAS de
   PORTADAS, que no llevan a ningun sitio.

   EL MOVIMIENTO es CSS puro (scroll-driven animations, biblioteca.css): sin
   soporte, o con movimiento reducido, todo se ve quieto y completo.

   EL BUSCADOR es solo del navegador: sin JavaScript no hay cuadro ni flechas, y
   se ven todas las tarjetas, cada una un enlace de verdad. Cada tarjeta lleva su
   indice (`data-buscar`), armado AQUI al compilar: el titulo, la linea, la
   palabra en su alfabeto, su id y el nombre de su tema, ya sin acentos ni
   mayusculas. initDestacados (site.js) solo compara lo escrito con ese indice,
   y lo escrito no va a ningun otro sitio. */
const { lang, t } = Astro.props;

const say = (o) => (o ? (o[lang] ?? o.es) : '');
const base = import.meta.env.BASE_URL;
const datos = { BOOKS, TIPOS, TERMS, GLOSS };
const temas = new Map(SECCIONES.map((s) => [s.id, s.nombre]));

const tarjetas = LIBROS.map((b) => {
  const f = fichaLibro(b, lang, datos, base);
  if (!f) return null;
  const nombre = temas.get(b.seccion);
  return { ...f, tema: say(nombre), indice: indexar([f.titulo, f.glosa, f.guion, f.id, say(nombre), nombre && nombre.es]) };
}).filter(Boolean);

/* La cartelera: el libro que dice data/biblioteca.js, o el primero que se abra */
const cartelera = tarjetas.find((p) => p.id === CARTELERA) ?? tarjetas[0] ?? null;

/* El texto de la cartelera es --slate sobre el tono del libro mezclado con el papel
   (biblioteca.css → --d-mezcla: 46% de dia, 28% de noche): tiene que leerse (4.5:1).
   Si un tono no llega, la compilacion para y dice cual: pon en CARTELERA un libro de un
   tono mas claro. Los hex son los de base.css/tokens.css (slate, papel, tiza, carbon). */
if (cartelera) {
  const mezcla = (a, b, pa) => '#' + [1, 3, 5].map((i) => Math.round(parseInt(a.slice(i, i + 2), 16) * pa + parseInt(b.slice(i, i + 2), 16) * (1 - pa)).toString(16).padStart(2, '0')).join('');
  const dia = contraste('#2B3A43', mezcla(cartelera.color.fondo, '#F7F4EB', 0.46));
  const noche = contraste('#F0EDE3', mezcla(cartelera.color.fondo, '#20211F', 0.28));
  if (dia < 4.5 || noche < 4.5) {
    throw new Error(`Destacados.astro: el texto de la cartelera («${cartelera.titulo}») no se lee sobre el color de su libro (${dia.toFixed(2)}:1 de dia, ${noche.toFixed(2)}:1 de noche; hace falta 4.5): pon en CARTELERA un libro de un tono mas claro.`);
  }
}

/* Una fila por tema con libros, en el orden de SECCIONES */
const filas = SECCIONES.map((s) => ({ id: s.id, nombre: say(s.nombre), tarjetas: tarjetas.filter((p) => p.seccion === s.id) })).filter((f) => f.tarjetas.length);

/* Las portadas sueltas: la fila «Pronto». comprobar() mira la forma de la
   direccion; que el archivo este de verdad lo mira esto, que corre al compilar. */
const pronto = PORTADAS.filter((p) => p.id === undefined).map((p) => {
  if (!rutaPortadaValida(p.imagen)) throw new Error(`Destacados.astro: la portada suelta «${p.titulo}» tiene una direccion de imagen que no vale (${String(p.imagen)}).`);
  if (!fs.existsSync(path.join(process.cwd(), 'public', p.imagen))) {
    throw new Error(`Destacados.astro: la portada suelta «${p.titulo}» apunta a public/${p.imagen}, que no existe.`);
  }
  return { imagen: `${base}${p.imagen}`, ancho: p.ancho, alto: p.alto, titulo: p.titulo, glosa: p.subtitulo ?? '', indice: indexar([p.titulo, p.subtitulo, t('soon.badge'), 'pronto']) };
});
if (pronto.length) filas.push({ id: 'pronto', nombre: t('soon.badge'), tarjetas: [], pronto });

const hay = tarjetas.length > 0 || pronto.length > 0;
---
{hay && (
<section class="destacados" id="destacados" aria-labelledby="dest-titulo" data-destacados data-libre data-sigue-tema>
  <div class="dest__shell">
    <div class="dest__cabeza">
      <h2 class="dest__title" id="dest-titulo" data-lift>{t('lib.featured')}</h2>

      {/* El cuadro se enseña con JavaScript (initDestacados): sin el, no serviria de nada. */}
      <div class="dest__buscar" role="search" data-dest-buscar hidden>
        <Icon id="search" />
        <label class="sr-only" for="dest-campo">{t('lib.search')}</label>
        <input id="dest-campo" class="dest__campo" type="search" placeholder={t('lib.search.hint')}
               maxlength={BUSCAR_MAX} autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" data-dest-campo />
      </div>
    </div>

    {cartelera && (
    <article class="cartelera" aria-labelledby="cartelera-titulo" data-cartelera style={`--tono:${cartelera.color.fondo}`}>
      {/* Tres capas que se mueven distinto al hacer scroll: la portada de fondo (la mas lenta), la portada de frente (la mas rapida) y el texto, quieto */}
      <div class="cartelera__fondo" aria-hidden="true">
        {cartelera.portada && <img src={cartelera.portada} alt="" width="900" height="1273" loading="lazy" decoding="async" />}
      </div>
      <div class="cartelera__velo" aria-hidden="true"></div>
      <div class="cartelera__cuerpo">
        <p class="cartelera__tema">{cartelera.tema}</p>
        <h3 class="cartelera__titulo" id="cartelera-titulo" lang={cartelera.idioma}>{cartelera.titulo}</h3>
        {cartelera.glosa && <p class="cartelera__glosa" lang={cartelera.idioma}>{cartelera.glosa}</p>}
        <a class="cartelera__boton" href={`#${cartelera.id}`} data-libro={cartelera.id} aria-haspopup="dialog">
          {t('lib.open')}
          <span class="sr-only">: <span lang={cartelera.marca ? cartelera.idioma : undefined}>{cartelera.titulo}</span></span>
        </a>
      </div>
      <div class="cartelera__libro" aria-hidden="true">
        {cartelera.portada ? (
          <img src={cartelera.portada} alt="" width="900" height="1273" loading="lazy" decoding="async" />
        ) : (
          <Tapa color={cartelera.color} guion={cartelera.guion} lengua={cartelera.lengua} dir={cartelera.dir} titulo={cartelera.titulo} idioma={cartelera.idioma} />
        )}
      </div>
    </article>
    )}

    <div class="filas" data-dest-filas>
      {filas.map((f) => (
        <div class="fila" data-fila>
          <h3 class="fila__titulo">{f.nombre}</h3>
          <div class="fila__escena">
            {/* La pared de la fila, con su luz: se mueve mas despacio que los libros */}
            <div class="fila__nicho" aria-hidden="true"><span class="fila__pared"></span></div>
            {/* Un riel que desborda y no lleva ni un enlace (la fila «Pronto») no se alcanza con el teclado: se le da foco y nombre */}
            <div class="fila__riel" data-riel {...(f.tarjetas.length ? {} : { tabindex: '0', role: 'group', 'aria-label': f.nombre })}>
              <ul class="fila__pista" role="list">
                {f.tarjetas.map((p, i) => (
                  <li class="dest__item" style={`--i:${i}`} data-buscar={p.indice}>
                    <a class="dest__tarjeta" href={`#${p.id}`} data-libro={p.id} aria-haspopup="dialog">
                      <span class="dest__portada" aria-hidden="true">
                        {p.portada ? (
                          <img src={p.portada} alt="" width="900" height="1273" loading="lazy" decoding="async" />
                        ) : (
                          <Tapa color={p.color} guion={p.guion} lengua={p.lengua} dir={p.dir} titulo={p.titulo} idioma={p.idioma} />
                        )}
                      </span>
                      {/* Lo que se ve, escondido a quien lee con voz: su nombre es el de abajo */}
                      <span class="dest__texto" aria-hidden="true">
                        <span class="dest__nombre" lang={p.idioma}>{p.titulo}</span>
                        {p.glosa && <span class="dest__glosa" lang={p.idioma}>{p.glosa}</span>}
                      </span>
                      {/* «Libro (en ingles):» va en el idioma de la PAGINA; solo el titulo y el subtitulo, en el del libro (y solo si es otro) */}
                      <span class="sr-only">{t('lib.book')}{p.marca ? ` (${t('lib.in.' + p.idioma)})` : ''}: <span lang={p.marca ? p.idioma : undefined}>{p.titulo}.{p.glosa ? ` ${p.glosa}` : ''}</span></span>
                    </a>
                  </li>
                ))}
                {(f.pronto || []).map((p, i) => (
                  <li class="dest__item" style={`--i:${i}`} data-buscar={p.indice}>
                    {/* Un libro que aun se escribe: solo se ve, no lleva a ningun sitio */}
                    <div class="dest__tarjeta dest__tarjeta--pronto" lang="es">
                      <span class="dest__portada">
                        <img src={p.imagen} alt="" width={p.ancho} height={p.alto} loading="lazy" decoding="async" />
                      </span>
                      <span class="dest__texto">
                        <span class="dest__nombre">{p.titulo}</span>
                        {p.glosa && <span class="dest__glosa">{p.glosa}</span>}
                        <span class="dest__pronto" lang={lang}>{t('soon.badge')}</span>
                      </span>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
            {/* Las flechas se enseñan con JavaScript, y solo si la fila no cabe (initDestacados) */}
            <button class="fila__flecha fila__flecha--ant" type="button" hidden data-flecha="-1" aria-label={`${t('carousel.prev')}: ${f.nombre}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button class="fila__flecha fila__flecha--sig" type="button" hidden data-flecha="1" aria-label={`${t('carousel.next')}: ${f.nombre}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
      ))}
    </div>

    {/* Cuando lo escrito no encuentra ninguno. No repite lo que se escribio. */}
    <div class="dest__vacio" data-dest-vacio hidden>
      <p class="dest__vacio-texto">{t('lib.search.none')}</p>
      <button class="dest__todos" type="button" data-dest-todos>{t('lib.search.all')}</button>
    </div>
    {/* Lo que queda tras buscar, para quien no lo ve (initDestacados). */}
    <p class="sr-only" role="status" data-dest-estado></p>
  </div>
</section>
)}
