---
import { CONTACT } from '../data/social.js';
import { HOUSES, HOLDING } from '../data/houses.js';
import Icon from './Icon.astro';

/* El directorio de las casas.

   Sustituye al asistente de diez pasos. Aquel recogia la solicitud entera
   —necesidades, presupuesto, plazos— y la guardaba para leerla despues; el
   problema no era el formulario, era que la respuesta tenia que salir de
   aqui. Ahora no: cada casa tiene su equipo y su propio sitio, y la
   solicitud entra por donde la van a atender.

   Lo unico que se decide en esta pagina es POR CUAL PUERTA. De ahi que cada
   ficha lleve el oficio y el criterio, y no una lista de servicios: entre
   tres listas de servicios todas suenan igual y el visitante elige la
   primera, que casi nunca es la suya.

   Son enlaces de verdad, no fichas de formulario. Salen del sitio, asi que
   van con `target` y con el dominio a la vista. */
const { lang, t } = Astro.props;
const say = (o) => (o ? (o[lang] ?? o.es) : '');
---

<ul class="hgrid">
  {HOUSES.map((h) => (
    <li>
      <a class="hcard" href={h.url} target="_blank" rel="noopener noreferrer">
        <span class="hcard__logo" aria-hidden="true" style={`--ls:${h.logoScale ?? 1}`}>
          <img src={h.logo} alt="" loading="lazy" decoding="async" />
        </span>
        <span class="hcard__name">{h.name}</span>
        <span class="hcard__role">{say(h.role)}</span>
        <span class="hcard__hint">{say(h.hint)}</span>
        {/* El dominio no es decoracion: es el aviso de que se sale del sitio.
            Quien pulsa tiene derecho a saber a donde va antes de pulsar. */}
        <span class="hcard__go">{h.domain}<Icon id="corner" /></span>
      </a>
    </li>
  ))}
</ul>

{/* LA MATRIZ, APARTE. Es la dueña de las tres de arriba, y ponerla como una
    cuarta ficha igual haria elegir entre una empresa y su propietaria. Aqui
    abajo, mas plana y mas ancha, se lee como lo que es: otro asunto. */}
<a class="holding" href={HOLDING.url} target="_blank" rel="noopener noreferrer">
  <span class="holding__logo" aria-hidden="true" style={`--ls:${HOLDING.logoScale ?? 1}`}>
    <picture>
      {HOLDING.webp && <source srcset={HOLDING.webp} type="image/webp" />}
      <img src={HOLDING.logo} alt="" loading="lazy" decoding="async" />
    </picture>
  </span>
  <span class="holding__text">
    <span class="holding__name">{HOLDING.name} <em>{say(HOLDING.role)}</em></span>
    <span class="holding__hint">{say(HOLDING.hint)}</span>
  </span>
  <span class="holding__go">{HOLDING.domain}<Icon id="corner" /></span>
</a>

{/* La puerta de los que ya me conocen. Se queda donde estaba —al pie y
    cerrada— porque no compite con las casas: quien la busca ya sabe que
    existe, y quien no, no la necesita. */}
<details class="cform__friends">
  <summary>{t('form.friends')}</summary>
  <div class="cform__friends-body">
    <p>{t('form.friendsBody')}</p>
    <ul class="cform__direct">
      {CONTACT.map((ch) => (
        <li>
          {ch.href ? (
            <a class={`link-chip net--${ch.id}`} href={ch.href}
               target={ch.id === 'whatsapp' ? '_blank' : undefined}
               rel={ch.id === 'whatsapp' ? 'noopener noreferrer' : undefined}>
              <Icon id={ch.id} /><span class="sr-only">{t(ch.key)}</span>
            </a>
          ) : (
            <button class={`link-chip net--${ch.id} is-soon`} type="button" data-soon="soon.whatsapp">
              <Icon id={ch.id} /><span class="sr-only">{t(ch.key)}</span>
            </button>
          )}
        </li>
      ))}
    </ul>
  </div>
</details>
