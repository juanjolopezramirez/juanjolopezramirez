---
import { CONTACT } from '../data/social.js';
import { HOUSES, HOLDING } from '../data/houses.js';
import Icon from './Icon.astro';
import Ficha from './Ficha.astro';

/* El directorio de las casas.

   DOS BLOQUES. Arriba, Let Be y Recvid, lado a lado: la exposicion, que te
   encuentren y que sepas contarte. Abajo, la familia Fraterni.

   FRATERNI VENTURES NO SE EXPLICA: ENCIERRA. Tenia pregunta, respuesta y
   mision como una casa mas, y no es una casa mas: es la que contiene a las
   otras. Ahora es solo su logotipo, montado sobre el borde del marco que
   rodea a los productos, como la etiqueta de una caja. Por eso es un
   <fieldset>: es la unica caja que corta su propio borde para dejar pasar
   la etiqueta, sin pintar un parche de fondo que en esta pagina —un
   degradado que se mueve— se notaria. Lleva `role="none"`, porque no agrupa
   campos de ningun formulario.

   LOS PRODUCTOS VAN POR RAMAS. Fraterni Academy es de FraterniU y Fraterni
   Business es de Fraterni Us, y las pestañas lo dicen: cada producto va en
   la misma pastilla que su madre y, en escritorio, colgado debajo con un
   codo. La rama sale de `padre` en houses.js.

   PESTAÑAS Y NO UN CARRUSEL QUE AVANZA SOLO. Uno automatico te cambia lo que
   estas leyendo sin que lo pidas, y las pautas de accesibilidad piden poder
   pararlo. Aqui se cambia tocando la pestaña, con las flechas del teclado o
   deslizando el dedo sobre la ficha (lo hace `initFamilia` en site.js). Sin
   guion no hay pestañas: se ven las cuatro fichas seguidas.

   Cada ficha sale de Ficha.astro. */
const { lang, t } = Astro.props;
const expo = HOUSES.filter((h) => h.grupo === 'exposicion');
const familia = HOUSES.filter((h) => h.grupo === 'fraterni');
/* Cada madre seguida de sus productos, en el orden de houses.js. */
const ramas = familia
  .filter((h) => !h.padre)
  .map((m) => [m, ...familia.filter((h) => h.padre === m.id)]);
const orden = ramas.flat();
---

<ul class="hgrid hgrid--casas">
  {expo.map((h) => <li><Ficha h={h} lang={lang} t={t} /></li>)}
</ul>

<section class="familia" aria-labelledby="familia-titulo" data-familia>
  <fieldset class="familia__marco" role="none">
    <legend class="familia__marca">
      <h2 class="familia__titulo" id="familia-titulo">
        <a href={HOLDING.url} target="_blank" rel="noopener noreferrer">
          <img src={HOLDING.logo} alt={HOLDING.name} width={HOLDING.w} height={HOLDING.h} decoding="async" />
        </a>
      </h2>
    </legend>
    {/* El lema de Ventures: lo que dicen las seis marcas, dicho una vez. */}
    {HOLDING.lema && <p class="familia__lema">{HOLDING.lema[lang] ?? HOLDING.lema.es}</p>}

    {/* Las pestañas vienen escondidas: sin guion no harian nada, y se ven las
        fichas seguidas. Los roles de panel los pone el guion, por la misma
        razon: un panel que dice ser de una pestaña que no se ve confunde. */}
    <div class="familia__pestanas" role="tablist" aria-label={t('house.family')} hidden>
      {ramas.map((rama) => (
        <div class="familia__rama">
          {rama.map((h, k) => (
            <button type="button" role="tab"
                    class:list={['familia__pestana', { 'familia__pestana--hija': k > 0 }]}
                    id={`pestana-${h.id}`} aria-controls={`panel-${h.id}`}
                    aria-selected={h === orden[0] ? 'true' : 'false'}
                    tabindex={h === orden[0] ? '0' : '-1'}>{h.corto ?? h.name}</button>
          ))}
        </div>
      ))}
    </div>
    <div class="familia__paneles">
      {orden.map((h) => (
        <div class="familia__panel" id={`panel-${h.id}`}>
          <Ficha h={h} lang={lang} t={t} nivel={3} />
        </div>
      ))}
    </div>
  </fieldset>
</section>

{/* La puerta de los que ya me conocen. Se queda donde estaba —al pie y
    cerrada— porque no compite con las casas: quien la busca ya sabe que
    existe, y quien no, no la necesita. */}
<details class="cform__friends">
  <summary>{t('form.friends')}</summary>
  <div class="cform__friends-body">
    <p>{t('form.friendsBody')}</p>
    <ul class="cform__direct">
      {CONTACT.map((ch) => (
        <li>
          {ch.href ? (
            <a class={`link-chip net--${ch.id}`} href={ch.href}
               target={ch.id === 'whatsapp' ? '_blank' : undefined}
               rel={ch.id === 'whatsapp' ? 'noopener noreferrer' : undefined}>
              <Icon id={ch.id} /><span class="sr-only">{t(ch.key)}</span>
            </a>
          ) : (
            <button class={`link-chip net--${ch.id} is-soon`} type="button" data-soon="soon.whatsapp">
              <Icon id={ch.id} /><span class="sr-only">{t(ch.key)}</span>
            </button>
          )}
        </li>
      ))}
    </ul>
  </div>
</details>
