---
import { NAV } from '../data/social.js';
import LangPicker from './LangPicker.astro';
import Icon from './Icon.astro';
const { lang, t, path = '', active = '' } = Astro.props;
const to = (slug) => `/${lang}/${slug}/`;
---
<!-- Nunca una barra: la cabecera flota sobre lo que haya debajo y solo
     se pone un vidrio detras cuando la pagina empieza a moverse. -->
<header class="site-header">
  <!-- Una sola pieza dice quien soy: la marca y la firma, juntas. -->
  <a class="brand" href={`/${lang}/`} aria-label="Juanjo López Ramírez">
    <!-- La firma se guarda tras la marca mientras el nombre esta a la
         vista, ahi abajo, a tamano completo. Al salir del hero asoma. -->
    <span class="brand__clip"><Icon id="lockup" /></span>
  </a>

  <div class="header-bar">
    <nav class="site-nav site-nav--wide" aria-label="Main">
      <ul class="site-nav__wide-list">
        {NAV.map((n) => (
          <li>
            <a href={to(n.slug)}
               class:list={[{ 'is-current': active === n.slug, 'is-soon': n.soon }]}
               aria-current={active === n.slug ? 'page' : undefined}>
              {t(n.key)}{n.soon && <span class="sr-only"> — {t('a11y.soon')}</span>}
            </a>
          </li>
        ))}
        <li class="site-nav__write">
          <!-- Ya no promete un destino: abre la hoja y que elija quien escribe. -->
          <button class="nav-cta" type="button" data-open-contact aria-haspopup="dialog">
            {t('nav.write')}
          </button>
        </li>
      </ul>
    </nav>

    <div class="site-header__tools">
      <div class="site-header__lang"><LangPicker lang={lang} t={t} path={path} /></div>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav"
              aria-label={t('a11y.menu')}>
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
      </button>
    </div>
  </div>

  <nav class="site-nav site-nav--drop" id="site-nav" aria-label="Menu">
    <ul class="site-nav__list">
      <li><a href={`/${lang}/`}>{t('nav.start')}</a></li>
      {NAV.map((n) => (
        <li>
          <a href={to(n.slug)} class:list={[{ 'is-soon': n.soon }]}>
            {t(n.key)}
            {n.soon && <span class="drop-badge">{t('soon.badge')}</span>}
          </a>
        </li>
      ))}
      <li>
        <button class="drop-write" type="button" data-open-contact aria-haspopup="dialog">
          {t('nav.write')}
        </button>
      </li>
    </ul>
  </nav>
</header>
