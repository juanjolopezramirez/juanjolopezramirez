---
import { NAV } from '../data/social.js';
import Icon from './Icon.astro';
/* `sky` cambia el suelo de la seccion por debajo de la costura: en vez
   de hueso, un verde que se mueve. Lo pide quien lo necesita —hoy solo
   el camino, que lleva el planeta— y el resto sigue en hueso. */
const { lang, t, slug, sky = false, sala = false } = Astro.props;
/* `sala`: el lado de la cabecera deja de ser pinar y es la sala de lectura (Recursos). */

const here = NAV.find((n) => n.slug === slug);
/* Las otras puertas de la casa: desde aqui se sigue, no se vuelve atras. */
const others = NAV.filter((n) => n.slug !== slug);

/* Si la seccion trae pie, la hoja deja de tener relleno abajo: lo que se
   apoya ahi va a sangre y pegado al borde, no dentro de un margen. */
const hasFoot = Astro.slots.has('foot');

/* El titulo, partido en «todo menos la ultima palabra» y «la ultima». El
   espacio de en medio se queda con la primera parte. */
const title = String(t(`page.${slug}.title`) ?? '');
const cut = title.lastIndexOf(' ') + 1;
const titleHead = title.slice(0, cut);
const titleTail = title.slice(cut);
---
<!-- El mismo hero del home, con los lados cambiados: aqui el hueso esta a
     la izquierda y el pinar a la derecha. Movil primero — una columna, lo
     que se lee arriba — y desde 1200px la costura, al reves. -->
<section class:list={['phero', { 'phero--foot': hasFoot, 'phero--sky': sky, 'phero--sala': sala }]} id="top">

  <div class="phero__field" aria-hidden="true"></div>

  <div class="phero__panel">
    <!-- La ultima palabra va en su <span> para que sketch.css la subraye a
         mano. El texto es exactamente el mismo; solo cambia que se pueda
         marcar aparte. -->
    <h1 class="phero__title" data-lift>{titleHead}<span class="phero__sub">{titleTail}</span></h1>
    <p class="phero__lead" data-lift>{t(`page.${slug}.lead`) ?? ''}</p>

    <!-- Lo que va debajo del lead, si la seccion lo trae: en Recursos, la
         busqueda y la cuenta de libros. -->
    <slot name="extra" />

    {here?.soon && (
      <p class="phero__status" data-lift>
        <span class="phero__status-dot" aria-hidden="true"></span>
        {t('soon.section')}
      </p>
    )}

  </div>

  <!-- Sobre el pinar: la marca, y por donde seguir desde aqui. -->
  <div class="phero__aside">
    <!-- Lo de dentro se puede relevar: proyectos pone ahi sus portadas en
         vez del sello y las puertas. Si nadie lo releva, sale esto. -->
    <slot name="aside">
    <span class="phero__seal" aria-hidden="true"><Icon id="mark" /></span>

    <nav class="phero__doors" aria-labelledby="phero-doors" data-lift>
      <h2 class="phero__doors-title" id="phero-doors">{t('page.next')}</h2>
      <ul class="phero__doors-list">
        {others.map((n) => (
          <li>
            <a class:list={['door', { 'is-soon': n.soon }]} href={`/${lang}/${n.slug}/`}>
              <span>{t(n.key)}</span>
              {n.soon && <span class="door__badge">{t('soon.badge')}</span>}
              <Icon id="corner" />
            </a>
          </li>
        ))}
        <li>
          <!-- Lleva al mismo portal que la cabecera. Aqui hay sitio para la
               pregunta entera, que invita mejor que el «Caminemos» corto. -->
          <a class="door door--write" href={`/${lang}/portal/`}>
            <span>{t('contact.cta')}</span>
            <Icon id="corner" />
          </a>
        </li>
      </ul>
    </nav>
    </slot>
  </div>

  <!-- El pie de la seccion: a sangre, pegado al borde de abajo del hueso. -->
  <slot name="foot" />
</section>
