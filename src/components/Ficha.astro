---
import Icon from './Icon.astro';
import Pregunta from './Pregunta.astro';
import { propositoDe } from '../data/manifesto.js';

/* La ficha de una casa. La misma en el directorio y en cada pestaña de la
   familia Fraterni: una sola, para que las dos no puedan decir cosas
   distintas.

   MINIMA. A la vista, la pregunta con su correccion y lo que es la casa en
   una frase. El resto va detras de los dos botones del pie:

     «¿Por qué?»  por que importa lo que la pregunta corrige.
     (i)          la mision y la vision, una linea cada una.

   La respuesta iba a la vista y la ficha era un parrafo: se leia como un
   folleto, no como una pregunta.

   LAS TRES CARAS OCUPAN EL MISMO SITIO. Lo que abren los botones no se
   despliega debajo —estiraria la ficha, y con ella la de al lado, que en la
   rejilla mide lo mismo—: sustituye a la cara de la pregunta, como el dorso
   de una tarjeta. Estan apiladas en la misma celda, asi que la ficha mide lo
   que la mas alta y no cambia de tamaño al darle la vuelta. Lo hace
   `initFichas` en site.js. SIN GUION no hay botones y las tres caras se ven
   seguidas.

   LA FICHA NO ES UN ENLACE ENTERO. El enlace es el nombre de la casa, y una
   capa invisible lo estira sobre la ficha: se pulsa en cualquier sitio, pero
   el lector de pantalla anuncia «Let Be» y no medio parrafo. Los botones van
   POR ENCIMA de esa capa; si no, tocarlos te llevaria al sitio de la casa.

   EL NOMBRE PUEDE SER UN LOGOTIPO. Fraterni Academy y Fraterni Business
   traen el suyo con el nombre escrito (`wordmark`), y ponerlo ademas en
   texto seria decirlo dos veces. Para quien no ve la imagen, el nombre
   sigue ahi: es su `alt`.

   UNA CASA SIN SITIO NO FINGE UN ENLACE: no lleva a ninguna parte, no se
   levanta al pasar el raton y dice que abre pronto donde las demas ponen su
   dominio.

   `nivel` es el del titulo: 2 en el directorio, 3 dentro de la familia, que
   ya tiene el suyo. */
const { h, lang, t, nivel = 2 } = Astro.props;
const say = (o) => (o ? (o[lang] ?? o.es) : '');
const p = propositoDe(h.id);
const Titulo = nivel === 3 ? 'h3' : 'h2';
const idPorque = `porque-${h.id}`;
const idMv = `mv-${h.id}`;
---
<article class:list={['hcard', { 'hcard--pronto': !h.url }]} data-ficha>
  {/* Con logotipo, el simbolo no va arriba: va a su izquierda, del alto de
      sus letras, y los dos se leen como una sola firma. */}
  {h.wordmark ? (
    <Titulo class="hcard__name hcard__name--marca">
      {h.logo && <img class="hcard__simbolo" src={h.logo} alt="" loading="lazy" decoding="async" />}
      {h.url ? (
        <a class="hcard__link" href={h.url} target="_blank" rel="noopener noreferrer">
          <img class="hcard__wordmark" src={h.wordmark} alt={h.name} style={`--wm:${h.wordmarkScale ?? 1}`} loading="lazy" decoding="async" />
        </a>
      ) : (
        <img class="hcard__wordmark" src={h.wordmark} alt={h.name} style={`--wm:${h.wordmarkScale ?? 1}`} loading="lazy" decoding="async" />
      )}
      {/* FraterniU lleva su U detras de «FRATERNI!», del mismo alto. */}
      {h.simboloDerecha && <img class="hcard__simbolo hcard__simbolo--derecha" src={h.simboloDerecha} alt="" style={`--sd:${h.simboloDerechaScale ?? 1}`} loading="lazy" decoding="async" />}
    </Titulo>
  ) : (
    <>
      <span class:list={['hcard__logo', { 'hcard__logo--marca': !h.logo }]} aria-hidden="true" style={`--ls:${h.logoScale ?? 1}`}>
        {h.logo ? <img src={h.logo} alt="" loading="lazy" decoding="async" /> : <Icon id={h.mark} />}
      </span>
      <Titulo class="hcard__name">
        {h.url ? <a class="hcard__link" href={h.url} target="_blank" rel="noopener noreferrer">{h.name}</a> : h.name}
      </Titulo>
    </>
  )}
  {p ? (
    <div class="hcard__caras">
      <div class="hcard__cara">
        <Pregunta texto={say(p.pregunta)} tacha={say(p.tacha)} pone={say(p.pone)} cls="hcard__pregunta" />
        <p class="hcard__que">{say(p.que)}</p>
      </div>
      {/* El remate encabeza el porque: primero la vuelta a la pregunta,
          despues la razon. Fue un acordeon aparte en la cara de la
          pregunta, y eran dos sitios para la misma respuesta. */}
      <div class="hcard__cara hcard__cara--dorso" id={idPorque}>
        {p.remate && <p class="hcard__remate">{say(p.remate)}</p>}
        <p class="hcard__porque">{say(p.porque)}</p>
      </div>
      <div class="hcard__cara hcard__cara--dorso" id={idMv}>
        {/* Origen, mision y vision: las tres patas. Sin el origen, la ficha
            decia que hace la casa y a donde va, pero no por que existe. */}
        <dl class="hcard__mv">
          {p.origen && <div><dt>{t('house.origen')}</dt><dd>{say(p.origen.corta)}</dd></div>}
          <div><dt>{t('house.mision')}</dt><dd>{say(p.mision.corta)}</dd></div>
          <div><dt>{t('house.vision')}</dt><dd>{say(p.vision.corta)}</dd></div>
        </dl>
      </div>
    </div>
  ) : (
    <p class="hcard__hint">{say(h.hint)}</p>
  )}
  <div class="hcard__pie">
    {p && (
      <div class="hcard__botones" hidden>
        <button type="button" class="hcard__boton" aria-expanded="false" aria-controls={idPorque}>
          {t('house.why')}<span class="hcard__signo" aria-hidden="true"></span>
        </button>
        <button type="button" class="hcard__boton hcard__boton--info" aria-expanded="false" aria-controls={idMv}
                aria-label={t('house.more')} title={t('house.more')}>
          <Icon id="info" />
        </button>
      </div>
    )}
    {h.url
      ? <span class="hcard__go">{h.domain}<Icon id="corner" /></span>
      : <span class="hcard__go hcard__go--pronto">{t('house.soon')}</span>}
  </div>
</article>
