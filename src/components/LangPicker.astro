---
import { META, otherLangs } from '../i18n/utils.js';
import Icon from './Icon.astro';
const { lang, t, path = '' } = Astro.props;
const clean = String(path).replace(/^\/+|\/+$/g, '');
const to = (l) => (clean ? `/${l}/${clean}/` : `/${l}/`);
---
<!-- Una bandera sola no dice "idioma" — dice "pais", que es otra cosa y era
     justo la confusion. Por eso cada idioma se nombra en su propio idioma
     (quien busca el suyo lo reconoce sin entender el que esta leyendo) y la
     aclaracion vive detras de un icono de informacion, junto a las banderas.
     Ahi la encuentra quien la necesita, y no interrumpe a quien no. -->
<div class="lang" data-lang>
  <!-- Solo en movil: la hoja se centra y esto oscurece lo de detras. -->
  <div class="lang__scrim" data-lang-close></div>

  <div class="lang__list" id="lang-list" hidden role="group" aria-label={t('a11y.langList')}>
    <div class="lang__head">
      <p class="lang__title">{t('lang.title')}</p>
      <button class="lang__info" type="button" data-lang-info
              aria-expanded="false" aria-controls="lang-note"
              aria-label={t('a11y.langNote')} title={t('a11y.langNote')}>
        <Icon id="info" />
      </button>
    </div>

    <div class="lang__note-wrap" id="lang-note">
      <div class="lang__note-inner">
        <p class="lang__note">{t('lang.note')}</p>
      </div>
    </div>

    <ul class="lang__options">
      {otherLangs(lang).map((l, i) => (
        <li style={`--d:${i * 55}ms`}>
          <a class="lang__option" href={to(l)} lang={l} hreflang={l}>
            <img src={META[l].flag} alt="" width="40" height="40" />
            <span class="lang__name">{META[l].name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <button class="lang__current" type="button" data-lang-toggle
          aria-expanded="false" aria-controls="lang-list"
          aria-label={t('a11y.lang')} title={t('a11y.lang')}>
    <img class="lang__flag" src={META[lang].flag} alt="" width="40" height="40" />
    <span class="lang__badge" aria-hidden="true"><Icon id="globe" /></span>
  </button>
</div>
