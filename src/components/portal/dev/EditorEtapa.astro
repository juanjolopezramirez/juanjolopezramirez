---
/* Developer-Mode → Sobre el camino: las etapas nuevas de «¿Por dónde he caminado?» y su
   editor (panel/dev/EditorEtapa.js). Entran en su año, antes de «Hoy» (data/camino.js).
   Las de siempre siguen en el codigo. */
import Actualizar from './Actualizar.astro';
import UsoIA from './UsoIA.astro';
import Ruta from './Ruta.astro';
import Paso from './Paso.astro';
import Revisar from './Revisar.astro';
import Pie from './Pie.astro';
import { ETAPAS } from '../../../data/portal/etapas.js';
import { IDIOMAS } from '../../../scripts/contenido/comun.js';

const { tx } = Astro.props;
const c = tx.camino;
---
<div class="dev" data-dev="camino">
  <p class="panel__aviso" data-aviso role="status" tabindex="-1" hidden></p>
  <p class="portal__error" data-error role="alert" hidden></p>

  <Actualizar tx={tx.actualizar} />

  <div class="dev__barra">
    <button class="portal__boton dev__nuevo" type="button" data-dev-nuevo>{c.nuevo}</button>
  </div>
  <ul class="panel__lista" role="list" data-dev-lista></ul>
  <p class="panel__vacio" data-dev-vacio>{c.vacio}</p>

  <form class="dev__form" data-dev-form hidden novalidate aria-labelledby="dev-camino-titulo">
    <h3 class="panel__subtitulo" id="dev-camino-titulo" tabindex="-1" data-dev-titulo
        data-nuevo={c.tituloNuevo} data-editar={c.tituloEditar}>{c.tituloNuevo}</h3>
    <Ruta pre="et" etapas={ETAPAS.camino} tx={tx} />

    <Paso pre="et" id="etapa" tx={tx}>
    <div class="dev__campo" data-campo="idiomaOriginal">
      <label class="portal__etiqueta" for="et-idioma">{tx.idioma}</label>
      <select class="portal__entrada dev__select" id="et-idioma" name="idiomaOriginal">
        {IDIOMAS.map((i) => <option value={i.id}>{i.nombre}</option>)}
      </select>
    </div>
    <div class="dev__campo" data-campo="cuando">
      <label class="portal__etiqueta" for="et-cuando">{c.cuando}</label>
      <input class="portal__entrada dev__mono dev__corto" id="et-cuando" name="cuando" inputmode="numeric" maxlength="4" autocomplete="off" aria-describedby="et-cuando-ayuda" />
      <p class="portal__ayuda" id="et-cuando-ayuda">{c.cuandoAyuda}</p>
    </div>
    <div class="dev__campo" data-campo="titulo">
      <label class="portal__etiqueta" for="et-titulo">{c.titulo}</label>
      <input class="portal__entrada" id="et-titulo" name="titulo" maxlength="80" autocomplete="off" aria-describedby="et-titulo-ayuda" />
      <p class="portal__ayuda" id="et-titulo-ayuda">{c.tituloAyuda}</p>
    </div>
    <div class="dev__campo" data-campo="texto">
      <label class="portal__etiqueta" for="et-texto">{c.texto}</label>
      <textarea class="portal__entrada portal__entrada--texto" id="et-texto" name="texto" rows="3" maxlength="600" aria-describedby="et-texto-ayuda"></textarea>
      <p class="portal__ayuda" id="et-texto-ayuda">{c.textoAyuda}</p>
    </div>
    <div class="dev__campo" data-campo="id">
      <label class="portal__etiqueta" for="et-id">{tx.nombreCorto}</label>
      <input class="portal__entrada dev__mono" id="et-id" name="id" maxlength="40" autocomplete="off" spellcheck="false" autocapitalize="off" aria-describedby="et-id-ayuda" />
      <p class="portal__ayuda" id="et-id-ayuda">{tx.nombreCortoAyuda}</p>
    </div>
    </Paso>

    <Paso pre="et" id="idiomas" tx={tx}>
    <div class="dev__versiones" data-versiones></div>
    <button class="portal__boton portal__boton--suave dev__mas" type="button" data-dev-version>{tx.otraVersion}</button>

    <UsoIA prefijo="et" tx={tx.ia} />
    </Paso>

    <Revisar pre="et" tx={tx} />
    <Pie tx={tx} />
  </form>

  <template data-plantilla="version-etapa">
    <fieldset class="dev__grupo dev__version" data-version>
      <legend class="portal__etiqueta">{tx.otraVersion}</legend>
      <div class="dev__campo">
        <label class="portal__etiqueta" data-para="v-idioma">{tx.versionIdioma}</label>
        <select class="portal__entrada dev__select" name="v-idioma" data-id="v-idioma">
          {IDIOMAS.map((i) => <option value={i.id}>{i.nombre}</option>)}
        </select>
      </div>
      <div class="dev__campo">
        <label class="portal__etiqueta" data-para="v-titulo">{c.titulo}</label>
        <input class="portal__entrada" name="v-titulo" data-id="v-titulo" maxlength="80" autocomplete="off" />
      </div>
      <div class="dev__campo">
        <label class="portal__etiqueta" data-para="v-texto">{c.texto}</label>
        <textarea class="portal__entrada portal__entrada--texto" name="v-texto" data-id="v-texto" rows="3" maxlength="600"></textarea>
      </div>
      <label class="dev__casilla">
        <input type="checkbox" name="v-ia" />
        <span>{tx.traducidaIA}</span>
      </label>
      <button class="panel__boton panel__boton--suave dev__quitar" type="button" data-quitar-version>{tx.quitarVersion}</button>
    </fieldset>
  </template>

  <template data-plantilla="fila-dev">
    <li class="panel__fila">
      <div class="panel__quien">
        <p class="panel__persona" data-campo-fila="titulo"></p>
        <p class="panel__fecha" data-campo-fila="detalle"></p>
      </div>
      <div class="panel__acciones">
        <span class="dev__estado" data-campo-fila="estado"></span>
        <button type="button" class="panel__boton panel__boton--suave" data-editar>{tx.editar}</button>
      </div>
    </li>
  </template>
</div>
