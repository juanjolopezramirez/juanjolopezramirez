---
/* Developer-Mode → Trabajos o Proyectos (los dos con este mismo editor: cambia la lista
   donde salen, PARTNERS o PROJECTS). Los campos son los de una tarjeta de la web
   (data/projects.js los explica) y, debajo, «Su página»: el editor de bloques estilo
   Notion (panel/dev/EditorBloques.js), un documento por idioma.

   `clase` es 'trabajos' o 'proyectos': los ids de los campos llevan su prefijo, porque
   las dos secciones viven en la misma pagina. */
import Actualizar from './Actualizar.astro';
import UsoIA from './UsoIA.astro';
import { IDIOMAS } from '../../../scripts/contenido/comun.js';

const { tx, clase } = Astro.props;
const c = tx.casas;
const k = tx.casas[clase];
const b = tx.bloques;
const pre = clase === 'trabajos' ? 'tb' : 'pr';
const ruta = clase === 'trabajos' ? 'work' : 'projects';
---
<div class="dev" data-dev={clase}>
  <p class="panel__aviso" data-aviso role="status" tabindex="-1" hidden></p>
  <p class="portal__error" data-error role="alert" hidden></p>

  <Actualizar tx={tx.actualizar} />

  <div class="dev__barra">
    <button class="portal__boton dev__nuevo" type="button" data-dev-nuevo>{k.nuevo}</button>
  </div>
  <ul class="panel__lista" role="list" data-dev-lista></ul>
  <p class="panel__vacio" data-dev-vacio>{k.vacio}</p>

  <form class="dev__form dev__form--ancho" data-dev-form hidden novalidate aria-labelledby={`dev-${clase}-titulo`}>
    <h3 class="panel__subtitulo" id={`dev-${clase}-titulo`} tabindex="-1" data-dev-titulo
        data-nuevo={k.tituloNuevo} data-editar={k.tituloEditar}>{k.tituloNuevo}</h3>

    <div class="dev__campo" data-campo="idiomaOriginal">
      <label class="portal__etiqueta" for={`${pre}-idioma`}>{tx.idioma}</label>
      <select class="portal__entrada dev__select" id={`${pre}-idioma`} name="idiomaOriginal">
        {IDIOMAS.map((i) => <option value={i.id}>{i.nombre}</option>)}
      </select>
    </div>
    <div class="dev__campo" data-campo="name">
      <label class="portal__etiqueta" for={`${pre}-nombre`}>{c.nombre}</label>
      <input class="portal__entrada" id={`${pre}-nombre`} name="titulo" maxlength="80" autocomplete="off" aria-describedby={`${pre}-nombre-ayuda`} />
      <p class="portal__ayuda" id={`${pre}-nombre-ayuda`}>{c.nombreAyuda}</p>
    </div>
    <div class="dev__campo" data-campo="id">
      <label class="portal__etiqueta" for={`${pre}-id`}>{tx.nombreCorto}</label>
      <input class="portal__entrada dev__mono" id={`${pre}-id`} name="id" maxlength="40" autocomplete="off" spellcheck="false" autocapitalize="off" aria-describedby={`${pre}-id-ayuda`} />
      <p class="portal__ayuda" id={`${pre}-id-ayuda`}>{tx.nombreCortoAyuda} <span class="dev__ruta">/es/<span data-ruta-id></span>/</span></p>
    </div>
    <div class="dev__campo" data-campo="role">
      <label class="portal__etiqueta" for={`${pre}-que`}>{c.que}</label>
      <input class="portal__entrada" id={`${pre}-que`} name="role" maxlength="120" autocomplete="off" />
    </div>
    <div class="dev__campo" data-campo="blurb">
      <label class="portal__etiqueta" for={`${pre}-blurb`}>{c.descripcion}</label>
      <textarea class="portal__entrada portal__entrada--texto" id={`${pre}-blurb`} name="blurb" rows="3" maxlength="400" aria-describedby={`${pre}-blurb-ayuda`}></textarea>
      <p class="portal__ayuda" id={`${pre}-blurb-ayuda`}>{c.descripcionAyuda}</p>
    </div>
    <div class="dev__campo" data-campo="tags">
      <label class="portal__etiqueta" for={`${pre}-tags`}>{tx.etiquetas}</label>
      <input class="portal__entrada" id={`${pre}-tags`} name="etiquetas" maxlength="400" autocomplete="off" aria-describedby={`${pre}-tags-ayuda`} />
      <p class="portal__ayuda" id={`${pre}-tags-ayuda`}>{tx.etiquetasAyuda}</p>
    </div>

    {/* Las tres imagenes: se miden aqui antes de subirlas y se ven en pequeño */}
    {[
      { campo: 'logo', nombre: 'logo', accept: 'image/png,image/webp,.png,.webp', titulo: c.logo, ayuda: c.logoAyuda, boton: c.elegirLogo },
      { campo: 'avatar', nombre: 'avatar', accept: 'image/png,image/webp,.png,.webp', titulo: c.avatar, ayuda: c.avatarAyuda, boton: c.elegirAvatar },
      { campo: 'banner', nombre: 'banner', accept: 'image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp', titulo: c.cabecera, ayuda: c.cabeceraAyuda, boton: c.elegirCabecera }
    ].map((x) => (
      <div class="dev__campo" data-campo={x.campo} data-imagen={x.campo}>
        <label class="portal__etiqueta" for={`${pre}-${x.nombre}`}>{x.titulo}</label>
        <span class="dev__elegir">
          <input class="dev__archivo" id={`${pre}-${x.nombre}`} name={x.nombre} type="file" accept={x.accept}
                 aria-describedby={`${pre}-${x.nombre}-ayuda ${pre}-${x.nombre}-nombre ${pre}-${x.nombre}-medida`} />
          <span class="dev__elegir-boton" aria-hidden="true">{x.boton}</span>
          <span class="dev__elegir-nombre" id={`${pre}-${x.nombre}-nombre`} data-nombre-archivo>{tx.ningunArchivo}</span>
        </span>
        <p class="portal__ayuda" id={`${pre}-${x.nombre}-ayuda`}>{x.ayuda} <span data-ya hidden>{c.yaTiene}</span></p>
        <div class:list={['dev__muestra', `dev__muestra--${x.campo}`]} data-muestra hidden>
          <canvas data-lienzo width="160" height="80" aria-hidden="true"></canvas>
        </div>
        <p class="dev__medida" id={`${pre}-${x.nombre}-medida`} data-medida aria-live="polite"></p>
      </div>
    ))}

    <fieldset class="dev__grupo" data-campo="works">
      <legend class="portal__etiqueta">{c.trabajos2}</legend>
      <div class="dev__trabajos" data-trabajos></div>
      <button class="portal__boton portal__boton--suave dev__mas" type="button" data-otro-trabajo>{c.otroTrabajo}</button>
    </fieldset>

    <div class="dev__versiones" data-versiones></div>
    <button class="portal__boton portal__boton--suave dev__mas" type="button" data-dev-version>{tx.otraVersion}</button>

    <section class="dev__pagina" aria-labelledby={`${pre}-pagina-titulo`} data-campo="cuerpo">
      <h4 class="dev__pagina-titulo" id={`${pre}-pagina-titulo`}>{c.pagina}</h4>
      <p class="portal__ayuda">{c.paginaLinea}</p>
      <div class="dev__campo dev__pagina-idioma">
        <label class="portal__etiqueta" for={`${pre}-pagina-idioma`}>{c.paginaIdioma}</label>
        <select class="portal__entrada dev__select" id={`${pre}-pagina-idioma`} data-pagina-idioma></select>
      </div>
      <div class="bed" data-bloques></div>
    </section>

    <UsoIA prefijo={pre} tx={tx.ia} />

    <p class="portal__error" data-error-form role="alert" hidden></p>
    <div class="dev__acciones">
      <button class="portal__boton" type="submit">{tx.guardar}</button>
      <button class="portal__boton portal__boton--suave" type="button" data-dev-publicar
              data-publicar={tx.publicar} data-despublicar={tx.despublicar} hidden>{tx.publicar}</button>
      <button class="portal__boton portal__boton--suave dev__borrar" type="button" data-dev-borrar
              data-borrar={tx.borrar} data-seguro={tx.borrarSeguro} hidden>{tx.borrar}</button>
      <button class="portal__boton portal__boton--suave" type="button" data-dev-cerrar>{tx.cerrar}</button>
    </div>
  </form>

  <template data-plantilla="version-casa">
    <fieldset class="dev__grupo dev__version" data-version>
      <legend class="portal__etiqueta">{tx.otraVersion}</legend>
      <div class="dev__campo">
        <label class="portal__etiqueta" data-para="v-idioma">{tx.versionIdioma}</label>
        <select class="portal__entrada dev__select" name="v-idioma" data-id="v-idioma">
          {IDIOMAS.map((i) => <option value={i.id}>{i.nombre}</option>)}
        </select>
      </div>
      <div class="dev__campo">
        <label class="portal__etiqueta" data-para="v-role">{c.que}</label>
        <input class="portal__entrada" name="v-role" data-id="v-role" maxlength="120" autocomplete="off" />
      </div>
      <div class="dev__campo">
        <label class="portal__etiqueta" data-para="v-blurb">{c.descripcion}</label>
        <textarea class="portal__entrada portal__entrada--texto" name="v-blurb" data-id="v-blurb" rows="3" maxlength="400"></textarea>
      </div>
      <label class="dev__casilla">
        <input type="checkbox" name="v-ia" />
        <span>{tx.traducidaIA}</span>
      </label>
      <button class="panel__boton panel__boton--suave dev__quitar" type="button" data-quitar-version>{tx.quitarVersion}</button>
    </fieldset>
  </template>

  <template data-plantilla="trabajo-casa">
    <div class="dev__trabajo" data-trabajo>
      <div class="dev__campo">
        <label class="portal__etiqueta" data-para="w-titulo">{c.trabajoTitulo}</label>
        <input class="portal__entrada" name="w-titulo" data-id="w-titulo" maxlength="120" autocomplete="off" />
      </div>
      <div class="dev__campo">
        <label class="portal__etiqueta" data-para="w-ano">{c.trabajoAno}</label>
        <input class="portal__entrada dev__mono dev__corto" name="w-ano" data-id="w-ano" maxlength="4" inputmode="numeric" autocomplete="off" />
      </div>
      <div class="dev__campo">
        <label class="portal__etiqueta" data-para="w-enlace">{c.trabajoEnlace}</label>
        <input class="portal__entrada dev__mono" name="w-enlace" data-id="w-enlace" maxlength="500" autocomplete="off" spellcheck="false" />
      </div>
      <button class="panel__boton panel__boton--suave dev__quitar" type="button" data-quitar-trabajo>{c.quitarTrabajo}</button>
    </div>
  </template>

  <template data-plantilla="fila-dev">
    <li class="panel__fila">
      <div class="panel__quien">
        <p class="panel__persona" data-campo-fila="titulo"></p>
        <p class="panel__fecha" data-campo-fila="detalle"></p>
      </div>
      <div class="panel__acciones">
        <span class="dev__estado" data-campo-fila="estado"></span>
        <button type="button" class="panel__boton panel__boton--suave" data-editar>{tx.editar}</button>
      </div>
    </li>
  </template>
</div>
