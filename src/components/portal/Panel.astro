---
import Icon from '../Icon.astro';
import BarraTerminal from './BarraTerminal.astro';
import AlefIcono from './AlefIcono.astro';
import Campo from './Campo.astro';
import { tp, jsonSeguro } from '../../data/portal/textos.js';
import { SECCIONES, GRUPOS, PLEGABLES, HECHAS } from '../../data/portal/secciones.js';
import EditorLibro from './dev/EditorLibro.astro';
import EditorEtapa from './dev/EditorEtapa.astro';
import EditorCasa from './dev/EditorCasa.astro';
import '../../styles/portal.css';
import '../../styles/panel.css';
import '../../styles/dev.css';

/* EL PANEL DE «ÁLEF» (/[lang]/portal/panel/).

   La misma terminal que la entrada (Tarjeta.astro), mas grande, sobre
   layouts/Terminal.astro: la barra (BarraTerminal.astro) con el logo, el
   nombre, la ruta (~/panel/hoy) y la pausa del fondo, el menu a la izquierda como un
   acordeon (Self-Mode, Developer-Mode, Acceso) y la seccion a la derecha. En el
   telefono, el menu va arriba detras de un solo boton «Menú».

   TODO (menos la barra) NACE ESCONDIDO (`hidden`) hasta que panel.js comprueba, con el SERVIDOR,
   que la persona entro y esta aprobada; si no, la manda de vuelta al portal.
   Las secciones «solo admin» las quita del DOM para quien no lo es, y las «solo
   miembros» (el test) para el admin. Eso es comodidad: lo que protege los datos
   son las reglas de la base.

   Las filas de «Quién entra» salen de los <template> de abajo y se rellenan con
   `textContent`, nunca con innerHTML. */
const { lang } = Astro.props;
const x = tp(lang);
const p = x.panel;
const hecha = (id) => HECHAS.includes(id);
---
<section class="panel" id="panel" data-panel data-idioma={lang} aria-labelledby="panel-nombre"
         lang={lang !== 'es' ? 'es' : undefined}>
  <div class="panel__marco">
    <!-- La barra se ve SIEMPRE, tambien mientras carga o si falla: lleva el boton
         para parar el fondo (WCAG 2.2.2) y el <h1> de la pagina. -->
    <BarraTerminal nombre={x.nombre} idTitulo="panel-nombre" ruta="~/panel"
                   pausar={x.fondo.pausar} seguir={x.fondo.seguir} lang={lang} inicio={x.inicio} />

    <noscript><p class="portal__nota panel__cargando">{p.sinJavascript}</p></noscript>
    <!-- Mientras la guardia pregunta al servidor: la א roja que late y la bitacora (carga.js). -->
    <div class="panel__cargando portal__espera" data-cargando>
      <AlefIcono nombre="logo" tono="rojo" class="portal__espera-logo" />
      <p class="portal__nota" role="status">{p.cargando}</p>
      <ol class="portal__bitacora" data-bitacora aria-hidden="true"></ol>
    </div>

    <div class="panel__problema" data-problema hidden tabindex="-1">
      <p class="portal__nota">{p.problema}</p>
      <button class="portal__boton portal__boton--suave panel__boton-solo" type="button" data-reintentar>{p.reintentar}</button>
    </div>

    <!-- EL CODIGO DE LA APP: si la cuenta del admin tiene codigo (seccion «Seguridad»),
         el panel no se abre hasta escribirlo. Con supabase/006 aplicado, la BASE tampoco
         abre nada de admin sin el: esto es la puerta, el cerrojo esta en el servidor. -->
    <div class="panel__codigo" data-codigo hidden>
      <h2 class="portal__titulo" id="panel-codigo-titulo" tabindex="-1">{p.codigo.titulo}</h2>
      <form class="portal__form panel__form" data-form="codigo" novalidate>
        {/* La instruccion va como ayuda del campo: el lector la oye al llegar el foco */}
        <Campo id="c-codigo" name="codigo" label={p.codigo.campo} ayuda={p.codigo.linea} inputmode="numeric" autocomplete="one-time-code" maxlength="9" />
        <p class="portal__error" data-error role="alert" hidden></p>
        <button class="portal__boton" type="submit">{p.codigo.boton}</button>
      </form>
      <button class="panel__salir" type="button" data-salir><Icon id="salir" /><span>{p.codigo.salir}</span></button>
    </div>

    <div class="panel__cuerpo" data-marco hidden>

    <!-- EL MENU, un acordeon: Self-Mode, Developer-Mode y Acceso se pliegan; se abre solo el
         grupo de la seccion en que estas (panel/Menu.js). En el telefono todo cabe detras de
         un boton «Menú» que dice donde estas y se cierra al elegir. Nada se guarda. -->
    <div class="panel__riel" data-riel>
      <button class="panel__menu-boton" type="button" aria-expanded="false" aria-controls="panel-menu" data-menu-boton>
        <span class="panel__menu-nombre">{p.menuBoton}</span><span class="sr-only">, </span>
        <span class="panel__menu-actual" data-menu-actual></span>
        <Icon id="pliegue" />
      </button>
      <nav class="panel__menu" id="panel-menu" aria-label={p.menu} data-menu>
        {GRUPOS.map((g) => {
          const plegable = PLEGABLES.includes(g);
          return (
            <div class="panel__grupo" data-grupo={g}
                 data-solo-admin={g === 'miembros' ? undefined : ''}
                 data-solo-miembros={g === 'miembros' ? '' : undefined}>
              {plegable && (
                <button class="panel__grupo-boton" type="button" id={`g-${g}`} aria-expanded="false" aria-controls={`gl-${g}`} data-acordeon={g}>
                  <span class="panel__grupo-nombre"><span class="panel__prompt" aria-hidden="true">// </span>{p.grupos[g]}</span>
                  <Icon id="pliegue" />
                </button>
              )}
              <ul class="panel__enlaces" id={`gl-${g}`} role="list"
                  aria-labelledby={plegable ? `g-${g}` : undefined}
                  aria-label={plegable ? undefined : p.grupos[g]}
                  hidden={plegable}>
                {SECCIONES.filter((s) => s.grupo === g).map((s) => (
                  <li>
                    <a class:list={['panel__enlace', { 'panel__enlace--pronto': !hecha(s.id) }]} href={`#${s.id}`} data-nav={s.id}>
                      <span>{p.secciones[s.id].titulo}</span>
                      {!hecha(s.id) && <span class="panel__marca-pronto"><span class="sr-only">, </span>{p.prontoCorto}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })}
      </nav>

      <button class="panel__salir" type="button" data-salir><Icon id="salir" /><span>{p.salir}</span></button>
    </div>

    <div class="panel__hoja">
      <p class="portal__demo" data-demo hidden>{x.demo}</p>

      {SECCIONES.map((s) => (
        <section class="panel__seccion" data-seccion={s.id} aria-labelledby={`s-${s.id}`} hidden
                 data-solo-admin={s.admin ? '' : undefined}
                 data-solo-miembros={s.soloMiembros ? '' : undefined}>
          <h2 class="panel__titulo" id={`s-${s.id}`} tabindex="-1" data-titulo={s.id}>{p.secciones[s.id].titulo}</h2>
          <p class="portal__linea">{p.secciones[s.id].linea}</p>

          {s.id === 'inicio' && (
            <ul class="panel__puertas" role="list">
              <li><a class="panel__puerta" href={`/${lang}/contact/`}>
                <span class="panel__puerta-titulo">{p.inicio.primerPaso.titulo}</span>
                <span class="panel__puerta-linea">{p.inicio.primerPaso.linea}</span>
              </a></li>
              <li><a class="panel__puerta" href={`/${lang}/meet/`}>
                <span class="panel__puerta-titulo">{p.inicio.cuadremos.titulo}</span>
                <span class="panel__puerta-linea">{p.inicio.cuadremos.linea}</span>
              </a></li>
            </ul>
          )}

          {s.id === 'accesos' && (
            <div class="panel__accesos">
              <p class="panel__aviso" data-aviso role="status" tabindex="-1" hidden></p>
              <p class="portal__error" data-error role="alert" hidden></p>

              {['pendientes', 'aprobados', 'rechazados'].map((l) => (
                <div class="panel__bloque" data-bloque={l}>
                  <h3 class="panel__subtitulo" tabindex="-1" data-subtitulo={l}>{p.accesos[l]} <span class="panel__cuenta" data-cuenta={l}></span></h3>
                  <ul class="panel__lista" role="list" data-lista={l}></ul>
                  <p class="panel__vacio" data-mas={l} hidden>{p.accesos.hayMas}</p>
                  <p class="panel__vacio" data-vacio={l}>{p.accesos[l === 'pendientes' ? 'nadiePendientes' : l === 'aprobados' ? 'nadieAprobados' : 'nadieRechazados']}</p>
                </div>
              ))}

              <div class="panel__bloque" data-bloque="invitar">
                <h3 class="panel__subtitulo" tabindex="-1">{p.accesos.invitar}</h3>
                <p class="portal__linea">{p.accesos.invitarLinea}</p>
                <form class="portal__form panel__form" data-form="invitar" novalidate>
                  <Campo id="i-correo" name="email" label={p.accesos.invitarCorreo} type="email" autocomplete="off" maxlength="254" inputmode="email" />
                  <p class="portal__error" data-error role="alert" hidden></p>
                  <button class="portal__boton panel__boton-solo" type="submit">{p.accesos.invitarBoton}</button>
                </form>
                <h3 class="panel__subtitulo panel__subtitulo--chico">{p.accesos.invitaciones}</h3>
                <ul class="panel__lista" role="list" data-lista="invitaciones"></ul>
                <p class="panel__vacio" data-vacio="invitaciones">{p.accesos.nadieInvitaciones}</p>
              </div>
            </div>
          )}

          {s.id === 'seguridad' && (
            <div class="panel__seguridad" data-seguridad>
              {/* Sin role="status": el aviso recibe el foco (el boton que se pulso puede
                  desaparecer) y con las dos cosas el lector lo diria dos veces. */}
              <p class="panel__aviso" data-aviso tabindex="-1" hidden></p>
              <p class="portal__error" data-error role="alert" hidden></p>
              <p class="portal__nota" data-estado-codigo></p>

              <h3 class="panel__subtitulo">{p.seguridad.dispositivos}</h3>
              <ul class="panel__lista" role="list" data-lista="dispositivos"></ul>
              <p class="panel__vacio" data-unico hidden>{p.seguridad.unico}</p>

              <button class="portal__boton portal__boton--suave panel__boton-solo" type="button" data-agregar>{p.seguridad.agregar}</button>

              {/* Añadir un dispositivo: el QR y la clave los pone panel.js (img.src y textContent) */}
              <div class="panel__alta" data-alta hidden>
                <p class="portal__linea">{p.seguridad.pasoQr}</p>
                <div class="panel__qr" data-qr></div>
                <p class="portal__linea">{p.seguridad.pasoClave}</p>
                <div class="panel__clave">
                  <p class="panel__secreto" data-secreto></p>
                  <button class="portal__boton portal__boton--suave panel__copiar" type="button" data-copiar>{p.seguridad.copiar}</button>
                </div>
                <form class="portal__form panel__form" data-form="confirmar" novalidate>
                  <Campo id="s-codigo" name="codigo" label={p.seguridad.campo} inputmode="numeric" autocomplete="one-time-code" maxlength="9" />
                  <p class="portal__error" data-error role="alert" hidden></p>
                  <div class="panel__acciones">
                    <button class="portal__boton panel__boton-solo" type="submit">{p.seguridad.confirmar}</button>
                    <button class="portal__boton portal__boton--suave panel__boton-solo" type="button" data-cancelar>{p.seguridad.cancelar}</button>
                  </div>
                </form>
              </div>

              <p class="portal__linea">{p.seguridad.sesiones}</p>
              <button class="portal__boton portal__boton--suave panel__boton-solo" type="button" data-cerrar-otras>{p.seguridad.cerrarOtras}</button>
            </div>
          )}

          {s.id === 'libros' && <EditorLibro tx={p.dev} />}
          {(s.id === 'trabajos' || s.id === 'proyectos') && <EditorCasa tx={p.dev} clase={s.id} />}
          {s.id === 'camino' && <EditorEtapa tx={p.dev} />}

          {!hecha(s.id) && (
            <div class="panel__pronto">
              <p class="portal__nota">{p.pronto}</p>
              {s.grupo === 'self' && <p class="portal__nota portal__nota--chica">{p.privado}</p>}
            </div>
          )}
        </section>
      ))}
    </div>
    </div>
  </div>

  <template data-plantilla="persona">
    <li class="panel__fila">
      <div class="panel__quien">
        <p class="panel__persona" data-campo="nombre"></p>
        <p class="panel__correo" data-campo="correo"></p>
        <p class="panel__motivo" data-campo="motivo"></p>
        <p class="panel__fecha" data-campo="fecha"></p>
      </div>
      <div class="panel__acciones">
        <button type="button" class="panel__boton" data-accion="aprobado" data-en="pendiente rechazado">{p.accesos.aprobar}</button>
        <button type="button" class="panel__boton panel__boton--suave" data-accion="rechazado" data-en="pendiente">{p.accesos.rechazar}</button>
        <button type="button" class="panel__boton panel__boton--suave" data-accion="rechazado" data-en="aprobado">{p.accesos.quitar}</button>
      </div>
    </li>
  </template>

  <template data-plantilla="dispositivo">
    <li class="panel__fila">
      <div class="panel__quien">
        <p class="panel__persona" data-campo="nombre"></p>
        <p class="panel__fecha" data-campo="fecha"></p>
      </div>
      <div class="panel__acciones">
        <button type="button" class="panel__boton panel__boton--suave" data-quitar>{p.seguridad.quitar}</button>
      </div>
    </li>
  </template>

  <template data-plantilla="invitacion">
    <li class="panel__fila">
      <div class="panel__quien">
        <p class="panel__persona" data-campo="correo"></p>
        <p class="panel__fecha" data-campo="estado"></p>
      </div>
      <div class="panel__acciones">
        <button type="button" class="panel__boton panel__boton--suave" data-borrar>{p.accesos.quitarInvitacion}</button>
      </div>
    </li>
  </template>

  <script type="application/json" id="portal-textos" set:html={jsonSeguro(x)}></script>
  <script>import '../../scripts/portal/panel.js';</script>
</section>
