---
import { ENLACE } from '../data/enlace.js';

/* ¿POR QUE TENGO UN DOMINIO? El aviso que sale al tocar mi foto del hero.

   Es el mismo aviso que el de «ya estas aqui» —centrado, con velo, se
   cierra con la equis, con el velo, con Escape o con el boton— y lleva sus
   clases: se ve igual porque es la misma pieza. Solo cambia la cabeza: en
   vez de la marca, los ojos de la primera version de la pagina, mirando a
   los lados y parpadeando.

   Vive solo en la portada, que es donde esta la foto que lo abre. El
   boton sobre la foto esta en Hero.astro (`data-open-enlace`). */
const { lang, t } = Astro.props;
const say = (o) => (o ? (o[lang] ?? o.es) : null);
---
<div class="here-panel enlace" id="enlace-panel" hidden>
  <div class="here-panel__scrim" data-close-enlace></div>
  <div class="here-panel__sheet" role="dialog" aria-modal="true"
       aria-labelledby="enlace-titulo" aria-describedby="enlace-texto">
    <button class="here-panel__close" type="button" data-close-enlace
            aria-label={t('a11y.closePanel')}>&times;</button>
    <span class="enlace__ojos" aria-hidden="true"></span>
    <p class="enlace__rotulo">{say(ENLACE.rotulo)}</p>
    <h2 class="here-panel__title" id="enlace-titulo">{say(ENLACE.titulo)}</h2>
    <p class="here-panel__body" id="enlace-texto">{say(ENLACE.texto)}</p>
    <button class="here-panel__ok" type="button" data-close-enlace>{say(ENLACE.ok)}</button>
  </div>
</div>
