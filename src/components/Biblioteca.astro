---
import { enElIdioma } from '../i18n/origen.js';
import { SECCIONES, LIBROS, TIPOS, PORTADAS, CARTELERA } from '../data/biblioteca.js';
import { TERMS } from '../i18n/terms.js';
import { GLOSS, CARDS } from '../i18n/term-cards.js';
import { DEEP } from '../i18n/term-book.js';
import { BOOKS } from '../data/books.js';
import { fichaLibro, comprobar } from '../scripts/biblioteca.js';
import { lomoDe } from '../data/lomos.js';
import '../styles/biblioteca.css';

/* La biblioteca de Recursos: estanterias con los libros de canto.

   Los datos y por que son asi, en data/biblioteca.js y scripts/biblioteca.js;
   el comportamiento (abrir el libro, la direccion de cada uno, la ola, el
   ultimo leido), en site.js → initBiblioteca().

   CADA TEMA CON LIBROS ES UN MUEBLE. Los temas sin libros no se dibujan: ni
   «pronto» ni su nombre (data/biblioteca.js). Los libros se ven por el lomo,
   sobre su tabla; el lomo es el que dibujo a mano quien hizo el libro
   (public/assets/lomos/) o, si no, uno que se dibuja solo con el tono del
   libro (`tono`; o el color de su carton, o el pino), la palabra y el titulo. Un libro de pasta blanda (revista, comic) es
   mas fino y lleva grapa.

   SIN JAVASCRIPT sigue siendo una pagina: cada libro es un enlace de verdad a
   su ancla (#ahava), que lleva a su lomo, y todos los muebles se ven. El
   script solo añade abrirlo, la ola, filtrar y recordar.

   EL IDIOMA. Los libros que no son de una palabra solo estan en español e
   ingles; en una pagina que no es de su idioma se ven igual, con una marca ES
   o EN en el lomo (y el nombre accesible lo dice). */
const { lang, t } = Astro.props;

const say = (o) => (o ? (o[lang] ?? o.es) : '');
const base = import.meta.env.BASE_URL;

/* La comprobacion de los datos para la compilacion, una sola vez por cambio
   de datos (esta pagina se pinta cinco veces y en desarrollo cada vez que se
   recarga). Un libro mal puesto para aqui; lo que no es grave, avisa. */
const firma = JSON.stringify([LIBROS, PORTADAS, CARTELERA, SECCIONES, Object.keys(BOOKS)]);
if (globalThis.__bibliotecaFirma !== firma) {
  /* La firma se guarda DESPUES: si comprobar() lanza, la siguiente carga (en
     desarrollo) vuelve a comprobar en vez de pintar datos rotos. */
  for (const aviso of comprobar({ SECCIONES, TIPOS, LIBROS, BOOKS, TERMS, GLOSS, CARDS, DEEP, PORTADAS, CARTELERA })) console.warn('[biblioteca] ' + aviso);
  globalThis.__bibliotecaFirma = firma;
}

/* Cada libro ya resuelto para ESTA pagina (fichaLibro, scripts/biblioteca.js):
   el idioma que se abre, su titulo, su color, su portada (la primera pagina del
   PDF, que initBiblioteca pide al acercarse el raton para que el libro la
   encuentre ya al abrirse) y, aqui, su lomo dibujado a mano si lo hay. Un libro
   sin version que abrir no sale. */
const datos = { BOOKS, TIPOS, TERMS, GLOSS };
const libros = LIBROS.map((b) => {
  const f = fichaLibro(b, lang, datos, base);
  return f && { ...f, lomo: lomoDe(f.id, f.idioma, f.grosor, base) };
}).filter(Boolean);

/* Los muebles: solo los temas que tienen algun libro, en el orden de SECCIONES. */
const muebles = SECCIONES.map((s) => ({ ...s, libros: libros.filter((l) => l.seccion === s.id) })).filter((m) => m.libros.length);
/* Con un solo mueble no hay nada que filtrar. */
const conFiltro = muebles.length >= 2;
---
{muebles.length > 0 && (
<section class="biblio" id="biblioteca" aria-labelledby="biblio-titulo" data-biblioteca data-filtrable data-libre data-sigue-tema>
  <div class="biblio__shell">
    <h2 class="biblio__title" id="biblio-titulo" data-lift>{t('lib.title')}</h2>
    <p class="biblio__lead" data-lift>{t('lib.lead')}</p>

    {/* Se pinta en el navegador, solo si hay un libro leido (initBiblioteca). */}
    <a class="seguir" href="#biblioteca" data-seguir hidden>
      <span class="seguir__marca">{t('lib.continue')}</span>
      <span class="seguir__titulo" data-seguir-titulo></span>
    </a>

    {conFiltro && (
      <div class="cards__filter biblio__filtro" data-filter-bar>
        <div class="faxis" role="group" aria-label={t('lib.topic')} data-axis="tema">
          <span class="faxis__label">{t('lib.topic')}</span>
          <span class="faxis__chips">
            {muebles.map((m) => (
              <button class="chip" type="button" data-filter={m.id} aria-pressed="false">{say(m.nombre)}</button>
            ))}
          </span>
        </div>
        <button class="cards__clear" type="button" data-filter-clear aria-label={t('lib.clear')} hidden>{t('filter.clear')}</button>
      </div>
    )}
    {/* Lo que queda tras filtrar, para quien no lo ve (initBiblioteca). */}
    <p class="sr-only" role="status" data-biblio-estado></p>

    <ul class="biblio__lista" role="list" data-filtrable-lista>
      {muebles.map((m) => (
        <li class="estante" data-tags={m.id}>
          <h3 class="estante__nombre">{say(m.nombre)}</h3>
          <div class="estante__mueble">
          <ul class="estante__libros" role="list">
            {m.libros.map((b, i) => (
              <li class="libro-item" id={b.id} style={`--i:${i}`} data-grosor={b.grosor} data-tipo={b.blando ? 'blando' : 'duro'}>
                <a class="libro" href={`#${b.id}`} data-libro={b.id} data-portada={b.portada} data-titulo={b.glosa ? `${b.titulo} · ${b.glosa}` : b.titulo} aria-haspopup="dialog">
                  {/* El lomo es lo que se ve; el nombre accesible va aparte (abajo) */}
                  <span class:list={['libro__lomo', { 'libro__lomo--hecho': b.lomo }]} aria-hidden="true"
                        style={b.lomo ? undefined : `--fondo:${b.color.fondo};--tinta:${b.color.tinta}`}>
                    {b.lomo ? (
                      <img class="libro__foto" src={b.lomo} alt="" decoding="async" loading="lazy" />
                    ) : (
                      <>
                        {b.guion && <span class="lomo__guion" lang={b.lengua}>{b.guion}</span>}
                        <span class="lomo__titulo" lang={b.idioma}>{b.titulo}</span>
                        {b.blando && <span class="lomo__grapa"></span>}
                      </>
                    )}
                    {b.marca && <span class="lomo__marca">{b.marca}</span>}
                  </span>
                  {/* El nombre accesible: «Libro (en ingles):» va en el idioma de la PAGINA; solo el titulo y el subtitulo, en el del libro (y solo si es otro) */}
                  <span class="sr-only">{t('lib.book')}{b.marca ? ` (${enElIdioma(lang, b.idioma, t)})` : ''}: <span lang={b.marca ? b.idioma : undefined}>{b.titulo}.{b.glosa ? ` ${b.glosa}` : ''}</span></span>
                </a>
              </li>
            ))}
          </ul>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
)}
