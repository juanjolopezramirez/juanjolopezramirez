---
import { RUTA, di } from '../../data/ruta/textos.js';

/* UNA RONDA: la pregunta, las cartas de la izquierda y la de la derecha.

   LAS DOS BARAJAS ENTERAS VIAJAN EN EL HTML, las diez rondas, y el guion
   solo enseña la que toca. Son treinta pares de frases: pesan menos que
   una foto, y a cambio no hay ni una peticion a mitad del juego. Quien
   elija «por mi negocio» no espera a que baje nada.

   LA CARTA DERECHA NO ESTA ESCONDIDA EN EL HTML, esta en la izquierda. El
   texto de «de que depende» viaja en el `data-depende` del boton que lo
   revela, asi que no hay una caja con la respuesta puesta y tapada con
   CSS: quien mire el codigo la vera igual, claro, pero no queda una
   respuesta visible para un lector de pantalla antes de tiempo.

   `aria-live` en la carta derecha: cuando se voltea, quien escucha se
   entera de que cambio algo ahi. Sin eso el volteo es invisible. */

const { lang, rama, ronda } = Astro.props;
---
<section class="ronda" data-rama={rama} data-ronda={ronda.ronda} hidden>
  <h2 class="ronda__pregunta">{di(ronda.pregunta, lang)}</h2>

  <div class="ronda__mesa">
    <div class="mesa__lado">
      <h3 class="mesa__rotulo">{di(RUTA.quiero, lang)}</h3>
      <ul class="mesa__cartas">
        {ronda.cartas.map((c) => (
          <li>
            <button class="carta carta--deseo" type="button"
                    data-carta={c.id}
                    data-depende={di(c.dependeDe, lang)}
                    aria-pressed="false">
              <span>{di(c.deseo, lang)}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="mesa__lado">
      <h3 class="mesa__rotulo">{di(RUTA.deQueDepende, lang)}</h3>
      {/* Boca abajo hasta que se elige. El dorso y la cara son la misma
          caja: si fueran dos, al voltear saltaria el alto. */}
      <div class="carta carta--depende" data-destapada="no" aria-live="polite">
        <p class="carta__dorso">{di(RUTA.bocaAbajo, lang)}</p>
        <p class="carta__cara" data-cara></p>
      </div>
    </div>
  </div>
</section>
