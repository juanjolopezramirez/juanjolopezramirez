---
import { SOCIAL } from '../data/social.js';
import Red from './Red.astro';
import Icon from './Icon.astro';

/* La fila de redes del hero.

   VAN TODAS, EN TANDAS. Se ven tres hasta 1200px y cinco de ahi en adelante
   —donde ademas entra WhatsApp, la decima (social.js)—, y cada siete
   segundos pasa la tanda siguiente (initRedes). El «+» del final gira un
   cuarto de vuelta en cada cambio: es la puerta a todas, y el giro dice que
   detras hay mas de lo que se ve. Al pasar el raton o el foco por la fila,
   se queda quieta.

   SIN GUION, o con menos movimiento pedido, no rota nada: se ve la primera
   tanda (`row: true`) y el resto sigue a un toque, en la hoja.

   Solo la primera tanda entra con `reveal`: las demas aparecen al rotar, y
   una entrada encima de la otra se veia doble. */
const { t } = Astro.props;
---
<div class="links" id="links">
  <h2 class="links__title">{t('links.title')}</h2>
  <ul class="links__list" data-redes>
    {SOCIAL.map((s) => (
      <li class:list={['links__item', `links__item--${s.id}`, { 'links__item--resto': !s.row }]}
          data-ancho={s.ancho ? true : undefined}>
        <Red s={s} t={t} cls={s.row ? 'reveal' : ''} />
      </li>
    ))}
    <li class="links__mas">
      <button class="link-chip link-chip--more" type="button" data-open-social
              aria-haspopup="dialog" aria-label={t('a11y.more')}>
        <Icon id="mas" />
      </button>
    </li>
  </ul>
</div>
