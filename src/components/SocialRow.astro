---
import { SOCIAL } from '../data/social.js';
import Icon from './Icon.astro';
const { t } = Astro.props;
const row = SOCIAL.filter((s) => s.row);
---
<div class="links" id="links">
  <h2 class="links__title">{t('links.title')}</h2>
  <ul class="links__list">
    {row.map((s) => (
      <li>
        <a class={`link-chip net--${s.id} reveal`} href={s.href} target="_blank" rel="noopener noreferrer">
          <Icon id={s.id} /><span class="sr-only">{s.name}</span>
        </a>
      </li>
    ))}
    <li>
      <button class="link-chip link-chip--more" type="button" data-open-social
              aria-haspopup="dialog" aria-label={t('a11y.more')}>
        <Icon id="more" />
      </button>
    </li>
  </ul>
</div>
