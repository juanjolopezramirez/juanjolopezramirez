---
import { SOCIAL } from '../data/social.js';
import Icon from './Icon.astro';
const { t } = Astro.props;
const row = SOCIAL.filter((s) => s.row);
---
<div class="links" id="links">
  <h2 class="links__title">{t('links.title')}</h2>
  <ul class="links__list">
    {row.map((s) => (
      <li class={`links__item links__item--${s.id}`}>
        <!-- Sigue siendo un enlace de verdad: sin JavaScript lleva a la
             cuenta de casa. Con JavaScript el guion se pone delante y
             abre la hoja, para que elija quien mira. -->
        <a class={`link-chip net--${s.id} reveal`} href={s.href} target="_blank" rel="noopener noreferrer"
           data-accounts={s.accounts ? s.id : undefined}
           data-account-name={s.accounts ? s.name : undefined}
           aria-haspopup={s.accounts ? 'dialog' : undefined}>
          <Icon id={s.id} /><span class="sr-only">{s.name}{s.accounts ? ` — ${t('a11y.accounts')}` : ''}</span>
        </a>
      </li>
    ))}
    <li>
      <button class="link-chip link-chip--more" type="button" data-open-social
              aria-haspopup="dialog" aria-label={t('a11y.more')}>
        <Icon id="more" />
      </button>
    </li>
  </ul>
</div>
