---
import { NAV } from '../data/social.js';
import SocialRow from './SocialRow.astro';
import Rhema from './Rhema.astro';
import Oferta from './Oferta.astro';
import Icon from './Icon.astro';
import { ENLACE } from '../data/enlace.js';
const { lang, t } = Astro.props;
const say = (o) => (o ? (o[lang] ?? o.es) : null);

/* Dos puertas, no cinco. Una lleva a la gente con la que he caminado,
   la otra a lo que estoy construyendo por cuenta propia. */
const soonOf = (slug) => NAV.find((n) => n.slug === slug)?.soon;
const DOORS = [
  { slug: 'work',     key: 'door.work',     soon: soonOf('work') },
  { slug: 'projects', key: 'door.projects', soon: soonOf('projects') }
];
---
<!-- Movil y tablet: la calcomania de siempre — el bosque y yo — y debajo
     el nombre. Escritorio: pinar liso a la izquierda, la hoja de hueso a
     la derecha, y yo de pie entre las dos. -->
<section class="hero" id="top">

  <!-- El campo. Pine es el ambiente; Iris, la luz que se mueve dentro.
       El degradado base no se anima nunca: las tres luces flotan encima
       de el, cada una a su ritmo. Nada que leer aqui. -->
  <div class="hero__field" aria-hidden="true"></div>

  <!-- LA PRIMERA PANTALLA: lo que cabe en la ventana. La hoja de hueso que
       viene despues es otra, y en movil siempre lo fue —el CSS ya la ponia
       la ultima, para «descubrirla bajando»—. Ahora esta declarado, asi que
       las dos miden lo mismo y el salto entre ellas es un salto de verdad.

       En escritorio este envoltorio se desvanece con `display: contents`. -->
  <div class="hero__first">

  <!-- El escenario: la calcomania. Solo en movil y tablet. -->
  <div class="hero__stage">
    <!-- Dos capas para el parallax: el bosque va lejos y la foto cerca, y
         cada una viaja a su velocidad al cambiar de pantalla. Son cajas
         aparte porque el bosque y la foto ya usan `translate` para flotar;
         la capa se mueve por fuera y el flote sigue dentro. -->
    <span class="hero__capa hero__capa--lejos" aria-hidden="true">
      <!-- El bosque es decoracion pura, asi que vive en el CSS: asi el
           escritorio, que no lo usa, tampoco lo descarga. -->
      <span class="hero__forest reveal"></span>
    </span>

    <span class="hero__capa hero__capa--cerca">
    <!-- Una sola descarga: el navegador elige por ancho, no por CSS.

         LA FOTO ES UN BOTON: al tocarla sale el aviso de por que tengo un
         dominio (Enlace.astro). Es un boton de verdad y no un clic sobre la
         imagen, para que llegue tambien el teclado. Lleva las clases de la
         foto, asi que se coloca y flota exactamente como ella. -->
    <button class="hero__me reveal" type="button" data-open-enlace
            aria-haspopup="dialog" aria-label={say(ENLACE.boton)}>
    <picture>
      <!-- En escritorio, el retrato con fondo; por debajo de 1200px, la
           calcomania recortada de siempre.

           La calcomania medía 179x191 y en un telefono se pinta a ~220px con
           tres pixeles por punto: se estiraba tres veces y se veia borrosa.
           Ahora sale de la maestra (ProfileJuanJoPic-Photoroom.png) a su
           tamaño nativo, 869x927, con el mismo encuadre, el mismo borde
           crema y el mismo color: la proporcion es la de antes, asi que el
           CSS no cambia. -->
      <source media="(min-width: 1200px)" srcset="/assets/img/me-hero.webp" type="image/webp" />
      <source media="(min-width: 1200px)" srcset="/assets/img/me-hero.png" />
      <source srcset="/assets/img/just-me.webp" type="image/webp" />
      <img src="/assets/img/just-me.png" width="869" height="927"
           alt="Juan José López Ramírez, mirando hacia un lado"
           decoding="async" fetchpriority="high" />
    </picture>
    </button>
    </span>
  </div>

  <div class="hero__identity">
    <p class="hero__greet" data-lift>{t('hero.greet')}</p>
    <h1 class="hero__name" data-lift>
      <span class="hero__name-line">Juanjo López</span>
      <span class="hero__name-line">Ramírez</span>
    </h1>
    <p class="hero__role" data-lift>{t('hero.role')}</p>

    <!-- Dos puertas, para que elegir sea facil -->
    <nav class="hero__doors" aria-labelledby="doors-title" data-lift>
      <h2 class="hero__doors-title" id="doors-title">{t('hero.explore')}</h2>
      <ul class="hero__doors-list">
        {DOORS.map((dr) => (
          <li>
            <a class:list={['door', { 'is-soon': dr.soon }]} href={`/${lang}/${dr.slug}/`}>
              <span>{t(dr.key)}</span>
              {dr.soon && <span class="door__badge">{t('soon.badge')}</span>}
              <Icon id="corner" />
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div data-lift><SocialRow t={t} /></div>

    <!-- LA PALABRA, EN LA PARTE VERDE. Solo en escritorio: ahi cierra la
         columna del nombre, al lado de las redes, y la hoja blanca se queda
         con lo que se ofrece y las dos puertas. Es otra copia de la misma
         cita —como la de «Sobre mi»—, porque el sitio donde vive cambia con
         el ancho y el documento es uno solo; la que no toca se esconde, y a
         un lector de pantalla tampoco le llega dos veces. -->
    <Rhema t={t} where="verde" />
  </div>

  <!-- El boton se queda siempre. Encima, exactamente encima, un gemelo
       relleno que invita a bajar y se retira al primer scroll: como no
       ocupa sitio en la fila, al irse no deja ningun hueco. -->
  <div class="cue">
    <a class="scroll-cue" href="#about">
      <span class="scroll-cue__sticker">{t('scroll.label')}</span>
      <Icon id="arrow" />
    </a>
    <span class="scroll-cue scroll-cue--twin" aria-hidden="true">
      <span class="scroll-cue__sticker">{t('scroll.label')}</span>
      <Icon id="arrow" />
    </span>
  </div>
  </div>

  <!-- La hoja de hueso: de donde sale el trabajo, y para quien es.

       EN EL TELEFONO ES UNA PANTALLA, la segunda y ultima del hero: la
       palabra, para quien es esto y las dos puertas. Llego a ser dos, y
       el hero entero pedia tres ventanas antes de llegar a ningun sitio.
       Lo que sobraba era lo que hago —el titular y su parrafo—, que no
       dice quien soy ni como escribirme: se mudo al hueso, detras de la
       puerta de «Sobre el camino» (Oferta.astro, `where="hueso"`). Desde
       600px no se mudo nada y esto sigue encabezando la hoja.

       SIN ENVOLTORIOS. Los dos que partian la hoja iban en
       `display: contents`, que no genera caja: eran los hijos directos de
       la hoja, asi que se tragaban `.hero__panel > *` —el `z-index: 4` que
       pone el contenido por delante del fondo de la hoja y de mi foto— y no
       lo pasaban a nadie. Desde 1200px la hoja pinta su propio hueso por
       encima, y el contenido entero se quedaba debajo: la hoja se veia
       vacia. Si alguna vez vuelve a hacer falta partirla, que sea con algo
       que genere caja. -->
  <!-- La hoja ya no toma prestado el titular de lo que hago para nombrarse:
       en el telefono ese titular no esta aqui —esta en el hueso— y un
       `aria-labelledby` si entra en lo escondido, asi que quien escucha oia
       la hoja llamarse por algo que no contiene, y ademas con las palabras
       de la otra copia. Cada pieza de dentro trae su propio nombre. -->
  <section class="hero__panel">
    <Rhema t={t} where="panel" />

    <!-- Solo desde 600px: en el telefono esto vive en el hueso. -->
    <Oferta t={t} where="panel" />

    <div class="hero__available" data-glossary data-lift>
      <p class="hero__status">
        <span class="hero__status-dot" aria-hidden="true"></span>
        {t('hero.availableFor')}
      </p>
      <p class="hero__emet">{t('hero.emet')}</p>
    </div>

    <!-- LAS DOS PUERTAS, EN EL TELEFONO. Arriba, en la identidad, viven las
         mismas dos (`hero__doors`), pero ahi se esconden por debajo de
         600px: en una pantalla estrecha no cabian al lado del nombre. Al
         final de esta hoja si caben, y es el ultimo sitio antes del hueso —
         quien llego hasta aqui ya sabe quien soy y lo siguiente que quiere
         es ver el trabajo.

         Con los nombres cortos del menu y no con los de arriba: dos
         pastillas de una linea, lado a lado, se leen de un vistazo. Desde
         600px esto no existe: mandan las puertas de la identidad. -->
    <nav class="hero__cta" aria-labelledby="cta-puertas" data-lift>
      <h3 class="hero__cta-title" id="cta-puertas">{t('hero.explore')}</h3>
      <ul class="hero__cta-list">
        <li>
          <a class="cta cta--lleno" href={`/${lang}/work/`}>
            <span>{t('nav.work')}</span><Icon id="corner" />
          </a>
        </li>
        <li>
          <a class="cta" href={`/${lang}/projects/`}>
            <span>{t('nav.projects')}</span><Icon id="corner" />
          </a>
        </li>
      </ul>
    </nav>
  </section>

</section>
