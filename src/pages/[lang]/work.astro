---
import { LANGS, useT } from '../../i18n/utils.js';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Partners from '../../components/Partners.astro';
import { PARTNERS } from '../../data/partners.js';
import Cards from '../../components/Cards.astro';
import Piezas from '../../components/Piezas.astro';
import { PIEZAS } from '../../data/piezas.js';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const t = useT(lang);
const title = t('page.work.title');

/* Los videos de todas las casas de esta seccion, en un carril con filtro. */
const casas = new Set(PARTNERS.map((p) => p.id));
const enVideo = PIEZAS.filter((p) => casas.has(p.casa));
---
<Base lang={lang} path="work" active="work" title={`${title} — Juan José López Ramírez`}>
  <PageHero lang={lang} t={t} slug="work">
    <Partners slot="foot" items={PARTNERS} title={t('door.work')} />
  </PageHero>

  <Cards lang={lang} t={t} items={PARTNERS} kind="work" title={t('cards.title')} />

  <section class="videos" aria-labelledby="videos-titulo">
    <div class="videos__shell">
      <h2 class="videos__titulo" id="videos-titulo">{t('piezas.title')}</h2>
      <p class="videos__lead">{t('piezas.lead')}</p>
      <Piezas lang={lang} t={t} items={enVideo} marcas />
    </div>
  </section>
</Base>
