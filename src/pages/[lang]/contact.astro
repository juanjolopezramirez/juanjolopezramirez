---
import { LANGS, useT } from '../../i18n/utils.js';
import Base from '../../layouts/Base.astro';
import Ruta from '../../components/ruta/Ruta.astro';
import { RUTA, di } from '../../data/ruta/textos.js';

/* DAR EL PRIMER PASO: /es/contact/, /en/contact/…

   Se llega por «Caminemos», por la puerta del paso (Panels.astro).

   AQUI HUBO UN DIRECTORIO DE MARCAS y antes de eso un formulario. Las dos
   cosas pedian lo mismo sin decirlo: que la persona ya supiera lo que
   necesita. El formulario le pedia que lo escribiera; el directorio, que
   eligiera puerta. Y quien llega aqui casi nunca lo sabe — sabe lo que
   quiere, que no es lo mismo.

   Ahora la pagina no pregunta que necesitas: lo averigua. Cinco rondas de
   dos cartas, lo que quiero contra de que depende, y al final dos cosas:
   en que paso del camino estas y si lo que pides es lo que te sirve. La
   pagina entrega el resultado entero antes de pedir nada, y lo unico que
   pide despues es escribir, si se quiere.

   TAMBIEN DICE QUE NO HACE FALTA. Siempre, en todos los resultados. Es la
   parte que impide que esto sea un catalogo con pasos.

   La direccion sigue en ingles en los cinco idiomas, como el resto del
   sitio: /es/contact/ y no /es/primer-paso/. */

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useT(lang);
const title = di(RUTA.titulo, lang);
---
<Base lang={lang} path="contact" active="contact"
      title={`${title} — Juan José López Ramírez`}
      description={di(RUTA.entrada, lang)}>
  <article class="epage rpage">
    {/* Aqui no va el campo verde del hero. Esta pagina es una mesa donde
        se juega: las cartas se tienen que ver contra el papel, no contra
        el bosque. El verde vuelve en lo que manda —las dianas, el nivel
        elegido— y el hueso se queda quieto debajo. */}
    <div class="epage__shell">
      <Ruta lang={lang} />
    </div>
  </article>

  {/* Solo en esta pagina: el juego no pinta nada en las demas y no tiene
      por que viajar con ellas. */}
  <script>import '../../scripts/ruta.js';</script>
</Base>
