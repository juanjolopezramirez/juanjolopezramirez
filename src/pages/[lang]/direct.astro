---
import { LANGS } from '../../i18n/utils.js';

/* /es/direct/, /en/direct/…: antes «Escribeme directo» (WhatsApp o correo, y para
   que sirve cada uno). Ahora eso vive al pie del portal «The Alef Code» —«¿Prefieres
   escribirme?»—, asi que esta direccion solo redirige. Se deja viva para que los
   enlaces viejos no se rompan. La version anterior de esta pagina esta en el
   historial de git. */
export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
return Astro.redirect(`/${lang}/portal/`, 301);
---
