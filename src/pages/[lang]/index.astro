---
import { LANGS, useT } from '../../i18n/utils.js';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Rhema from '../../components/Rhema.astro';
import Orbit from '../../components/Orbit.astro';
import Signature from '../../components/Signature.astro';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const t = useT(lang);
---
<Base lang={lang} path="">
  <Hero lang={lang} t={t} />

  <section class="about" id="about" aria-labelledby="about-title" data-glossary>
    <h2 class="sr-only" id="about-title">{t('scroll.label')}</h2>

    <!-- El retrato va primero en el documento a proposito: en movil y
         tablet cae justo despues del hero, entre el pinar y el hueso, a
         sangre. Desde 1024px la rejilla lo manda a la derecha y deja de
         ser una banda para ser una copia enmarcada. -->
    <figure class="about__portrait reveal" data-orbit>
      <div class="about__print">
        <picture>
          <source srcset="/assets/img/me-quote.webp" type="image/webp" />
          <img src="/assets/img/me-quote.jpg" width="1080" height="1920"
               alt="Juanjo, de perfil, mirando hacia arriba"
               loading="lazy" decoding="async" />
        </picture>
        <!-- El pie ancho de una instantanea esta para escribir en el.
             Aqui se escribe sola, cuando los objetos ya se han posado. -->
        <Signature cls="print-sign" />
        <!-- Dentro del marco, no al lado: asi los objetos heredan todo lo
             que le pase a la copia —el flote, la inclinacion, el enderezarse
             al tocarla— en vez de tener que imitarlo desde fuera. -->
        <Orbit />
      </div>
    </figure>

    <div class="about__body">
      <!-- En movil la palabra abre la seccion: se lee antes que el texto.
           Desde 600px vive en la hoja del hero. -->
      <Rhema t={t} where="about" />

      <h2 class="about__heading reveal">
        {/* La palabra a mano y el punto van juntos en la misma caja: el
            punto es un nodo de texto aparte y se caia solo al renglon
            siguiente cuando el ancho no daba. */}
        {t('about.heading')} <span class="about__heading-end"><em class="script">{t('hero.lightly')}</em>.</span>
      </h2>

      <p class="reveal">{t('about.p1')}</p>
    </div>
  </section>
</Base>
