---
import { LANGS, useT } from '../../i18n/utils.js';
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Rhema from '../../components/Rhema.astro';
import Orbit from '../../components/Orbit.astro';
import Signature from '../../components/Signature.astro';
import Ligero from '../../components/Ligero.astro';
import Enlace from '../../components/Enlace.astro';
import Icon from '../../components/Icon.astro';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params;
const t = useT(lang);
---
<Base lang={lang} path="">
  <Hero lang={lang} t={t} />

  <section class="about" id="about" aria-labelledby="about-title" data-glossary>
    <h2 class="sr-only" id="about-title">{t('scroll.label')}</h2>

    <!-- El retrato va primero en el documento a proposito: en movil y
         tablet cae justo despues del hero, entre el pinar y el hueso, a
         sangre. Desde 1024px la rejilla lo manda a la derecha y deja de
         ser una banda para ser una copia enmarcada. -->
    <figure class="about__portrait reveal" data-orbit>
      <div class="about__print">
        <picture>
          <source srcset="/assets/img/me-quote.webp" type="image/webp" />
          <img src="/assets/img/me-quote.jpg" width="1080" height="1920"
               alt="Juanjo, de perfil, mirando hacia arriba"
               loading="lazy" decoding="async" />
        </picture>
        <!-- El pie ancho de una instantanea esta para escribir en el.
             Aqui se escribe sola, cuando los objetos ya se han posado. -->
        <Signature cls="print-sign" />
        <!-- Dentro del marco, no al lado: asi los objetos heredan todo lo
             que le pase a la copia —el flote, la inclinacion, el enderezarse
             al tocarla— en vez de tener que imitarlo desde fuera. -->
        <Orbit />
      </div>
    </figure>

    <div class="about__body">
      <!-- En movil la palabra abre la seccion: se lee antes que el texto.
           Desde 600px vive en la hoja del hero. -->
      <Rhema t={t} where="about" />

      <h2 class="about__heading reveal">
        {/* Lo escrito a mano y el punto van juntos en la misma caja: el
            punto es un nodo de texto aparte y se caia solo al renglon
            siguiente cuando el ancho no daba.

            A mano va «un solo camino», con su propia clave: antes era
            `hero.lightly`, pero esa palabra la siguen usando la cita y la
            pregunta del paramo, y no cambian. */}
        {t('about.heading')} <span class="about__heading-end"><em class="script">{t('about.headingHand')}</em>.</span>
      </h2>

      <p class="reveal">{t('about.p1')}</p>

      {/* Donde termina de explicarse el ágape: quien acaba de leer de dónde
          vengo es quien quiere seguir por el camino. La puerta va aquí y no
          en el menú solo, porque aquí es donde nace la pregunta. */}
      <a class="cta cta--tinta reveal" href={`/${lang}/about/`}>
        <span>{t('nav.about')}</span><Icon id="corner" />
      </a>
    </div>
  </section>

  {/* La pregunta que sigue al titular de arriba, con el paramo detras. La
      respuesta —el camino recorrido, con su linea de tiempo— ya no vive
      aqui: se mudo a «Sobre el camino», y ahi el mismo paramo pregunta por
      donde he caminado. Aqui se queda la pregunta de siempre. */}
  <Ligero t={t} />

  {/* El aviso de por que tengo un dominio: se abre al tocar mi foto del
      hero. Escondido no mide nada, asi que el salto entre pantallas no lo
      cuenta. */}
  <Enlace lang={lang} t={t} />
</Base>
