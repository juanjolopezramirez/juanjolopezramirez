---
import Signature from '../components/Signature.astro';
import { LANGS, DEFAULT_LANG } from '../i18n/utils.js';
/*
  La raiz no redirige por cabecera: eso deja una pagina en blanco con el
  texto "Redirecting from / to /es/" durante un parpadeo. En su lugar se
  sirve esta, que es pinar desde el primer pixel y escribe la firma trazo
  a trazo mientras elige el idioma del navegador. El <meta refresh> es la
  red de seguridad para quien no tenga JavaScript.

  Solo se ve una vez por sesion: volver a la raiz no vuelve a hacerte
  esperar. Y si el sistema pide menos movimiento, no hay espera ninguna.
*/
const langs = JSON.stringify(LANGS);
---
<!DOCTYPE html>
<html lang={DEFAULT_LANG}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#263B28" />
  <meta name="robots" content="noindex" />
  <title>Juanjo López Ramírez</title>
  <link rel="icon" href="/assets/logos/mark-icon.svg" type="image/svg+xml" />
  <link rel="canonical" href={`/${DEFAULT_LANG}/`} />
  <noscript><meta http-equiv="refresh" content={`0; url=/${DEFAULT_LANG}/`} /></noscript>
  <style is:global>
    html, body { height: 100%; }
    /* El mismo suelo que el hero: la diagonal de ocho paradas del estilo
       "The Gradient" con su velo negro al 20% encima. Aqui va en crudo y
       sin variables porque esta hoja se pinta antes que ninguna otra: es
       el primer pixel de la sesion y no puede esperar a un CSS externo.
       La firma va centrada, y el centro de una diagonal cae siempre en
       su punto medio sea cual sea la pantalla: #3F532E, verde medio, con
       la firma en hueso encima. La esquina de arriba a la izquierda es el
       extremo cerrado (#1E2F20) y la de abajo a la derecha el claro. */
    body {
      margin: 0;
      display: grid;
      place-items: center;
      background:
        linear-gradient(rgba(0, 0, 0, .2), rgba(0, 0, 0, .2)),
        linear-gradient(to top left,
          #A5CF4D  0%,
          #7D9B4E 27%,
          #678345 38%,
          #526B3B 48%,
          #3C5332 63%,
          #31472D 71%,
          #263B28 78%,
          #263B28 95%),
        #263B28;
      color: #F1EFE9;
    }
    /* Mas pequeno: la firma ocupaba media pantalla para un segundo de
       espera. 22rem -> 12rem y la marca de 26px -> 15px, un 45% menos. */
    .boot { display: grid; justify-items: center; gap: 1rem; width: min(52vw, 12rem); }
    .boot__mark {
      width: 15px; height: auto;
      animation: bootMark .55s cubic-bezier(.16,1,.3,1) both;
    }
    .boot__sign { width: 100%; height: auto; overflow: visible; }

    /* Cada trazo se descubre de izquierda a derecha, en el orden en que
       se dibujo. Doce trazos escalonados leen como una mano escribiendo,
       no como una imagen apareciendo. */
    .sig__p {
      clip-path: inset(-5% 101% -5% -5%);
      animation: sigWrite 340ms cubic-bezier(.34,.66,.38,1) forwards;
      animation-delay: calc(var(--i) * 55ms + 120ms);
    }
    @keyframes sigWrite { to { clip-path: inset(-5% -5% -5% -5%); } }
    @keyframes bootMark { from { opacity: 0; transform: translateY(8px); } }

    @media (prefers-reduced-motion: reduce) {
      .boot__mark, .sig__p { animation: none; }
      .sig__p { clip-path: none; }
    }
  </style>
</head>
<body>
  <div class="boot" role="img" aria-label="Juanjo López Ramírez">
    <img class="boot__mark" src="/assets/logos/mark-bone.svg" alt="" width="19" height="32" />
    <Signature />
  </div>

  <script is:inline define:vars={{ langs, DEFAULT_LANG }}>
    (function () {
      var known = JSON.parse(langs);
      var pick = DEFAULT_LANG;
      var wanted = (navigator.languages || [navigator.language || '']);
      for (var i = 0; i < wanted.length; i++) {
        var tag = String(wanted[i]).toLowerCase().split('-')[0];
        if (known.indexOf(tag) !== -1) { pick = tag; break; }
      }
      var dest = '/' + pick + '/';

      /* Nadie tiene por que esperar dos veces a la misma firma, ni esperar
         nada si ha pedido menos movimiento. */
      var seen = false;
      try { seen = sessionStorage.getItem('jlr:boot') === '1'; sessionStorage.setItem('jlr:boot', '1'); } catch (e) {}
      var quiet = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var wait = (seen || quiet) ? 0 : 1120;      // lo que tarda el ultimo trazo

      /* El destino se va cargando por detras mientras se escribe. */
      var pre = document.createElement('link');
      pre.rel = 'prefetch'; pre.href = dest;
      document.head.appendChild(pre);

      setTimeout(function () { location.replace(dest); }, wait);
    })();
  </script>
</body>
</html>
