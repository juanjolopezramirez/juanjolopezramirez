---
import { LANGS, DEFAULT_LANG } from '../i18n/utils.js';
/*
  La raiz no redirige por cabecera: eso deja una pagina en blanco con el
  texto "Redirecting from / to /es/" durante un parpadeo. En su lugar se
  sirve esta pagina, que es pinar desde el primer pixel, elige el idioma
  del navegador y se va sola. El <meta refresh> es la red de seguridad
  para quien no tenga JavaScript.
*/
const langs = JSON.stringify(LANGS);
---
<!DOCTYPE html>
<html lang={DEFAULT_LANG}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#263B28" />
  <meta name="robots" content="noindex" />
  <title>Juanjo López Ramírez</title>
  <link rel="icon" href="/assets/logos/mark-icon.svg" type="image/svg+xml" />
  <link rel="canonical" href={`/${DEFAULT_LANG}/`} />
  <noscript><meta http-equiv="refresh" content={`0; url=/${DEFAULT_LANG}/`} /></noscript>
  <style>
    html, body { height: 100%; }
    body {
      margin: 0;
      display: grid;
      place-items: center;
      background: #263B28;
      color: #F1EFE9;
    }
    .boot { display: grid; justify-items: center; gap: 1.5rem; }
    .boot__mark { width: 26px; height: auto; animation: bootIn .7s cubic-bezier(.16,1,.3,1) both; }
    /* Una linea que se llena una vez. Si tarda mas, se queda llena:
       una barra que da vueltas miente sobre lo que esta pasando. */
    .boot__bar {
      width: 132px; height: 2px;
      background: rgba(241, 239, 233, .18);
      overflow: hidden;
    }
    .boot__bar::after {
      content: "";
      display: block;
      width: 100%; height: 100%;
      background: #7D9B4E;
      transform-origin: left;
      animation: bootBar 1.1s cubic-bezier(.22,.61,.36,1) both;
    }
    @keyframes bootIn { from { opacity: 0; transform: translateY(10px); } }
    @keyframes bootBar { from { transform: scaleX(0); } to { transform: scaleX(1); } }
    @media (prefers-reduced-motion: reduce) {
      .boot__mark, .boot__bar::after { animation: none; }
    }
  </style>
</head>
<body>
  <div class="boot">
    <img class="boot__mark" src="/assets/logos/mark-bone.svg" alt="Juanjo López Ramírez" width="19" height="32" />
    <div class="boot__bar" aria-hidden="true"></div>
  </div>

  <script is:inline define:vars={{ langs, DEFAULT_LANG }}>
    (function () {
      var known = JSON.parse(langs);
      var pick = DEFAULT_LANG;
      var wanted = (navigator.languages || [navigator.language || '']);
      for (var i = 0; i < wanted.length; i++) {
        var tag = String(wanted[i]).toLowerCase().split('-')[0];
        if (known.indexOf(tag) !== -1) { pick = tag; break; }
      }
      location.replace('/' + pick + '/');
    })();
  </script>
</body>
</html>
