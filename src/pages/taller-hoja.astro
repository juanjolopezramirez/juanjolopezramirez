---
/* LA HOJA DEL TALLER: la pagina que va dentro del marco de la vista previa. Sin el estilo del
   sitio ni el del portal: lo que se ve aqui es lo que se imprime. No esta en el mapa del sitio y
   sin el panel no hace nada. */
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>Hoja</title>
    <style is:inline>
      @media screen {
        html { background: #3b3f46; }
        body { margin: 0; }
        .pagedjs_pages { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; padding: 14px; zoom: var(--zoom, 1); }
        .pagedjs_page { background: #fff; box-shadow: 0 2px 10px rgb(0 0 0 / .4); }
      }
    </style>
  </head>
  <body>
    <div id="destino"></div>
    <script>
      import '../scripts/portal/taller-hoja/hoja.js';
    </script>
  </body>
</html>
