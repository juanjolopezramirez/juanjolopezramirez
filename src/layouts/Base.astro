---
import { useT, LANGS, META } from '../i18n/utils.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Panels from '../components/Panels.astro';
import Curtain from '../components/Curtain.astro';
import { AVISO_CSS, AVISO_TEXTOS, AVISO_MARCA, AVISO_RECARGA } from '../data/aviso.js';
import '../styles/base.css';
import '../styles/tablet.css';
import '../styles/desktop.css';

const { lang, path = '', active = '', title, description } = Astro.props;
const t = useT(lang);
const clean = String(path).replace(/^\/+|\/+$/g, '');

/* Absolutas, no relativas. `hreflang` exige direccion completa —con
   dominio— y con `/es/` a secas el buscador no valida ninguna de las
   cinco: es lo que tiraba la nota de SEO. El dominio sale de `site` en
   astro.config.mjs, asi que hay un solo sitio donde cambiarlo. */
const origin = String(Astro.site ?? '').replace(/\/$/, '');
const alt = (l) => `${origin}/${l}/${clean ? clean + '/' : ''}`;
const canonical = alt(lang);
---
<!DOCTYPE html>
<html lang={lang} data-theme="pine">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <!-- EL GUARDIAN. Lo primero de la cabecera, y sin pedir nada a nadie.

       Una vez la pagina se vio a medias: el HTML sin su hoja de estilos. La
       causa: GitHub Pages guarda el HTML diez minutos y cada publicacion
       cambia el nombre de los ficheros de /_astro/. Un HTML guardado de
       antes pide un fichero que ya no existe. La hoja de estilos ya va
       dentro de cada pagina (astro.config.mjs) y eso no puede volver a
       pasar; el guion sigue fuera, y sin el el telon no se levanta.

       Asi que esto vigila tres cosas: que no falle al cargar ningun fichero
       propio, que la hoja este puesta y que el guion haya terminado
       (`js-ready`, la ultima linea de site.js). Si algo falla:

         1. Recarga UNA vez sola, pidiendo la pagina con \`?r=\` para que el
            CDN no devuelva la guardada. Casi siempre basta.
         2. Si vuelve a fallar —o si no hay conexion—, no insiste: enseña el
            aviso de la casa (data/aviso.js) con un boton para volver a
            cargar. Sin conexion, recarga sola en cuanto vuelve.

       Al salir bien, borra el \`?r=\` de la barra de direcciones. -->
  <script is:inline define:vars={{ css: AVISO_CSS, textos: AVISO_TEXTOS, marca: AVISO_MARCA, recarga: AVISO_RECARGA }}>
    var h = document.documentElement, CLAVE = 'jlr:reintento', caido = false;
    var idioma = function () { var l = (h.lang || 'es').slice(0, 2); return textos[l] ? l : 'es'; };
    var param = function () { try { return new URL(location.href).searchParams.get('r'); } catch (e) { return null; } };
    var recargar = function () {
      var u = new URL(location.href); u.searchParams.set('r', Date.now().toString(36)); location.replace(u.href);
    };
    var ya = function () {
      /* ¿Se acaba de reintentar? Por la marca guardada o, si el navegador no
         deja guardar, por el propio \`?r=\` de hace menos de un minuto. */
      var t = 0; try { t = +sessionStorage.getItem(CLAVE) || 0; } catch (e) {}
      var r = parseInt(param() || '', 36);
      return Date.now() - Math.max(t, isNaN(r) ? 0 : r) < 60000;
    };
    var aviso = function (sinRed) {
      if (document.getElementById('aviso-carga')) return;
      h.classList.remove('js-curtain');                 /* que el telon no tape el aviso */
      var t = textos[idioma()];
      var st = document.createElement('style'); st.textContent = css; document.head.appendChild(st);
      var caja = document.createElement('div');
      caja.id = 'aviso-carga'; caja.className = 'aviso';
      caja.setAttribute('role', 'alertdialog'); caja.setAttribute('aria-labelledby', 'aviso-titulo');
      caja.innerHTML =
        '<div class="aviso__cuerpo">' +
          '<span class="aviso__marca" aria-hidden="true">' + marca + '</span>' +
          '<p class="aviso__rotulo">' + (sinRed ? t.rotuloRed : t.rotulo) + '</p>' +
          '<h1 class="aviso__titulo" id="aviso-titulo">' + (sinRed ? t.tituloRed : t.titulo) + '</h1>' +
          '<p class="aviso__texto">' + (sinRed ? t.textoRed : t.texto) + '</p>' +
          '<div class="aviso__botones">' +
            '<button type="button" class="aviso__boton">' + recarga + '<span>' + t.boton + '</span></button>' +
            '<a class="aviso__enlace" href="/' + idioma() + '/">' + t.inicio + '</a>' +
          '</div>' +
        '</div>' +
        '<p class="aviso__firma">Juan José López Ramírez</p>';
      document.body.appendChild(caja);
      var b = caja.querySelector('button');
      b.addEventListener('click', recargar);
      b.focus();
      if (sinRed) addEventListener('online', recargar, { once: true });
    };
    var falla = function () {
      if (caido || h.classList.contains('js-ready')) return;
      caido = true;
      var sinRed = navigator.onLine === false;
      if (!sinRed && !ya()) {
        try { sessionStorage.setItem(CLAVE, String(Date.now())); } catch (e) {}
        recargar();
        return;
      }
      if (document.body) aviso(sinRed);
      else document.addEventListener('DOMContentLoaded', function () { aviso(sinRed); });
    };
    /* Un fichero propio que no llega. Los errores de carga no suben por el
       arbol, pero si se ven en la fase de captura. Las letras de Google y
       lo demas de fuera no cuentan: sin ellas la pagina funciona igual. */
    addEventListener('error', function (e) {
      var el = e.target, src = el && (el.src || el.href);
      if (!src || !(el.tagName === 'SCRIPT' || (el.tagName === 'LINK' && /stylesheet/.test(el.rel)))) return;
      try { if (new URL(src, location.href).origin !== location.origin) return; } catch (x) { return; }
      falla();
    }, true);
    var comprobar = function () {
      var estilos = getComputedStyle(h).getPropertyValue('--papel').trim() !== '';
      if (estilos && h.classList.contains('js-ready')) {
        try { sessionStorage.removeItem(CLAVE); } catch (e) {}
        if (param() && history.replaceState) {
          var u = new URL(location.href); u.searchParams.delete('r'); history.replaceState(history.state, '', u.href);
        }
        return;
      }
      falla();
    };
    /* Los guiones de modulo corren antes de \`load\`: si al llegar \`load\` no
       hay \`js-ready\`, el guion no llego o se rompio por el camino. El
       respiro es para los moviles lentos. Y si \`load\` no llega nunca —una
       imagen colgada—, se mira igual a los doce segundos. */
    addEventListener('load', function () { setTimeout(comprobar, 2500); });
    document.addEventListener('DOMContentLoaded', function () { setTimeout(comprobar, 12000); });
  </script>
  <meta name="theme-color" content="#263B28" />
  <title>{title ?? t('doc.title')}</title>
  <meta name="description" content={description ?? t('hero.role')} />

  <link rel="icon" href="/assets/logos/mark-icon.svg" type="image/svg+xml" />
  <!-- Cual es la buena de las cinco. Sin esto, las cinco traducciones
       compiten entre ellas por la misma consulta. -->
  <link rel="canonical" href={canonical} />
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={alt(l)} />)}
  <link rel="alternate" hreflang="x-default" href={alt('es')} />

  <link rel="preload" as="image" href="/assets/img/me-hero.webp" type="image/webp" media="(min-width: 1200px)" />
  <link rel="preload" as="image" href="/assets/img/just-me.webp" type="image/webp" media="(max-width: 1199px)" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Antes de pintar nada: si hay JavaScript, el telon esta puesto. Si no,
       no se pone nunca y los enlaces navegan como siempre. -->
  <script is:inline>document.documentElement.classList.add('js-curtain');</script>
  <!-- La apariencia elegida, antes de pintar. Si se pusiera despues, quien
       eligio oscuro veria un destello de hueso en cada pagina. Sin nada
       guardado no se toca: manda el dispositivo (ThemePicker.astro).

       «Segun el sol» se resuelve aqui mismo: `jlrSol` dice si donde estas ya
       se puso el sol, con la ecuacion del amanecer. El lugar lo guarda
       site.js la primera vez (sale de la zona horaria); mientras no esta, se
       estima la longitud por el desfase horario de invierno, y el ecuador de
       latitud. site.js vuelve a preguntarle cada minuto. -->
  <script is:inline>window.jlrSol=function(){var c=[],r=Math.PI/180,y=new Date().getFullYear();try{c=(localStorage.getItem('jlr:sol')||'').split(',');}catch(e){}var o=Math.max(new Date(y,0,1).getTimezoneOffset(),new Date(y,6,1).getTimezoneOffset()),la=c.length===2?+c[0]:0,lo=c.length===2?+c[1]:-o/4,d=Date.now()/864e5-10957.5,j=Math.round(d+lo/360)-lo/360,M=(357.5291+.98560028*j)*r,L=M+(1.9148*Math.sin(M)+.02*Math.sin(2*M)+.0003*Math.sin(3*M)+282.9372)*r,t=j+.0053*Math.sin(M)-.0069*Math.sin(2*L),s=Math.sin(L)*Math.sin(23.4397*r),k=(Math.sin(-.833*r)-Math.sin(la*r)*s)/(Math.cos(la*r)*Math.sqrt(1-s*s)),w=Math.acos(Math.max(-1,Math.min(1,k)))/(2*Math.PI);return Math.abs(d-t)>w?'oscuro':'claro';};try{var jlrTema=localStorage.getItem('jlr:tema');if(jlrTema==='sol')jlrTema=jlrSol();if(jlrTema==='claro'||jlrTema==='oscuro')document.documentElement.setAttribute('data-tema',jlrTema);}catch(e){}</script>
  <!-- La altura de la ventana, tomada una sola vez y antes de pintar.
       Lo que se mida contra ella deja de moverse cuando el navegador
       esconde su barra al primer scroll. Va aqui y no en site.js para
       que el primer fotograma ya salga con la medida buena. -->
  <script is:inline>document.documentElement.style.setProperty('--vh0', window.innerHeight + 'px');</script>
  <!-- Las fuentes ya no bloquean el primer pintado.

       Una hoja de estilo normal para el navegador: hasta que no llega,
       no pinta nada. Y esta viene de otro dominio, asi que antes de
       pedirla hay que resolver el DNS y abrir la conexion. En un movil
       con red mala eso es medio segundo de pantalla en blanco por una
       hoja que solo dice que tipografias usar.

       El truco de `media="print"` la baja igual y con la misma prisa,
       pero el navegador la da por no aplicable y no espera a ella para
       pintar. Cuando termina de bajar, `onload` la pasa a `all` y entra.
       Las letras ya venian con `display=swap`, asi que el texto se ve
       desde el primer momento con la de respaldo y cambia al llegar la
       buena — que es exactamente lo que pasaba antes, solo que ahora sin
       la espera en blanco de delante.

       El `noscript` es para quien no tenga JavaScript: ahi va normal. -->
  <link rel="stylesheet" media="print" onload="this.media='all'"
        href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,500;12..96,600;12..96,800&family=Petemoss&display=swap" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,500;12..96,600;12..96,800&family=Petemoss&display=swap" />
  </noscript>
</head>

<body>
  <a class="skip-link" href="#main">{t('a11y.skip')}</a>
  <Header lang={lang} t={t} path={path} active={active} />
  <main id="main"><slot /></main>
  <Footer t={t} />
  <Panels lang={lang} t={t} />
  <Curtain />
  <script>import '../scripts/site.js';</script>
</body>
</html>
