---
import { useT, LANGS, META } from '../i18n/utils.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Panels from '../components/Panels.astro';
import Curtain from '../components/Curtain.astro';
import '../styles/base.css';
import '../styles/tablet.css';
import '../styles/desktop.css';

const { lang, path = '', active = '', title, description } = Astro.props;
const t = useT(lang);
const clean = String(path).replace(/^\/+|\/+$/g, '');
const alt = (l) => (clean ? `/${l}/${clean}/` : `/${l}/`);
---
<!DOCTYPE html>
<html lang={lang} data-theme="pine">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#263B28" />
  <title>{title ?? t('doc.title')}</title>
  <meta name="description" content={description ?? t('hero.role')} />

  <link rel="icon" href="/assets/logos/mark-icon.svg" type="image/svg+xml" />
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={alt(l)} />)}
  <link rel="alternate" hreflang="x-default" href={alt('es')} />

  <link rel="preload" as="image" href="/assets/img/me-hero.webp" type="image/webp" media="(min-width: 1200px)" />
  <link rel="preload" as="image" href="/assets/img/just-me.webp" type="image/webp" media="(max-width: 1199px)" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- Antes de pintar nada: si hay JavaScript, el telon esta puesto. Si no,
       no se pone nunca y los enlaces navegan como siempre. -->
  <script is:inline>document.documentElement.classList.add('js-curtain');</script>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Young+Serif&family=Bricolage+Grotesque:opsz,wght@12..96,300;12..96,400;12..96,500;12..96,600;12..96,800&family=Petemoss&display=swap" />
</head>

<body>
  <a class="skip-link" href="#main">{t('a11y.skip')}</a>
  <Header lang={lang} t={t} path={path} active={active} />
  <main id="main"><slot /></main>
  <Footer t={t} />
  <Panels t={t} />
  <Curtain />
  <script>import '../scripts/site.js';</script>
</body>
</html>
