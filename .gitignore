node_modules/
dist/
.astro/
public/books/

# Variables del portal: son tuyas, no se suben. `.env.example` si se sube.
.env
.env.*
!.env.example

# Copias de la semilla con tu correo dentro (el repositorio es publico)
supabase/900_semilla_admin.sql
supabase/*.local.sql

# Restos de trabajo que no son la web
__pycache__/
.claude/
_respaldos/
/_*.mjs

# Cache de la herramienta de diseno (impeccable): no es la web
.impeccable/
graphify-out/

# Lo que trae tools/traer-contenido.mjs de la base al publicar (Developer-Mode): vive solo
# en la maquina de GitHub, nunca en el repositorio. Los src/data/remoto/*.js SI se suben,
# pero vacios: si alguna vez tienen filas, es que se corrio con --aqui y no hay que subirlos.
public/assets/remoto/
